<%- await include('../layout/email-head', {
  subject: 'Welcome to ' + franchise.franchiseName + ' Admin Portal',
  preheader: 'Your admin account is ready — see your access details below.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Admin access',
  title: 'Welcome to the ' + franchise.franchiseName + ' admin portal',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">Dear <%= adminName %>,</p>

<p style="margin:0 0 24px 0;">
  Your admin account has been successfully created for the <%= franchise.franchiseName %> system.
</p>

<%- await include('../partials/section-open', { heading: 'Account details', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Email', value: adminEmail }) %>
  <% if (typeof role !== 'undefined' && role) { %>
    <%- await include('../partials/info-row', { label: 'Role', value: role }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Account created', value: createdDate || new Date().toLocaleString(), last: true }) %>
<%- await include('../partials/section-close') %>

<% if (typeof temporaryPassword !== 'undefined' && temporaryPassword) { %>
  <%- await include('../partials/alert', {
    tone: 'warning',
    title: 'Temporary password',
    text: 'Use the temporary password provided separately to log in. You’ll be required to change it on your first login.'
  }) %>
<% } %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Access admin portal', franchise: franchise }) %>
<% } %>

<p style="margin:0 0 16px 0;color:#4b5563;">
  Questions? Contact the system administrator.
</p>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
