<%- await include('../layout/email-head', {
  subject: 'Welcome to the ' + franchise.franchiseName + ' console',
  preheader: 'An admin account has been created for you — sign in to get started.',
  franchise: franchise,
  icon: '⌘'
}) %>

<%- await include('../partials/heading', {
  title: 'Welcome to the ' + franchise.franchiseName + ' console.',
  lead: 'Hi ' + adminName + ' — your admin account is ready. Use the details below to sign in.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Your account' }) %>
  <%- await include('../partials/info-row', { label: 'Email', value: adminEmail }) %>
  <% if (typeof role !== 'undefined' && role) { %>
    <%- await include('../partials/info-row', { label: 'Role', value: role }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Created', value: createdDate || new Date().toLocaleString(), last: true }) %>
<%- await include('../partials/section-close') %>

<% if (typeof temporaryPassword !== 'undefined' && temporaryPassword) { %>
  <%- await include('../partials/alert', {
    tone: 'warning',
    text: 'A temporary password was sent separately. You’ll be asked to change it on first sign-in.'
  }) %>
<% } %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Open the console', franchise: franchise }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Welcome aboard,', team: franchise.franchiseName + ' Operations', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
