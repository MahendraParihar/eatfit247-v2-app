<%
  const _expiry = (typeof expiryHours !== 'undefined' && expiryHours) ? (expiryHours + ' hour' + (expiryHours == 1 ? '' : 's')) : '15 minutes';
-%>
<%- await include('../layout/email-head', {
  subject: 'Reset your ' + franchise.franchiseName + ' admin password',
  preheader: 'Use the secure link below to reset your admin password. Expires in ' + _expiry + '.',
  franchise: franchise,
  icon: '⚿'
}) %>

<%- await include('../partials/heading', {
  title: 'Reset your admin password',
  lead: 'Hi ' + adminName + ' — we received a request to reset the password on your admin account. Tap the button to choose a new one.'
}) %>

<% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
  <%- await include('../partials/button', { href: resetUrl, label: 'Reset admin password', franchise: franchise, width: '240' }) %>
<% } %>

<%- await include('../partials/alert', {
  tone: 'warning',
  text: 'This link expires in ' + _expiry + '. Didn’t request a reset? Forward this email to the system administrator immediately — it may indicate unauthorised access.'
}) %>

<% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
  <%- await include('../partials/prose', {
    text: 'Trouble with the button? Copy and paste this URL into your browser:<br/><span style="word-break:break-all; color:#111827;">' + resetUrl + '</span>',
    isHtml: true
  }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Stay safe,', team: franchise.franchiseName + ' Security', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
