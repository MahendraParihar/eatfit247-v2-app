<%- await include('../layout/email-head', {
  subject: 'Admin password updated',
  preheader: 'Your ' + franchise.franchiseName + ' admin password has been updated.',
  franchise: franchise,
  icon: '✓'
}) %>

<%- await include('../partials/heading', {
  title: 'Admin password updated',
  lead: 'Hi ' + adminName + ' — the password on your ' + franchise.franchiseName + ' admin account was just changed.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Change details' }) %>
  <%- await include('../partials/info-row', { label: 'When', value: changeDate || new Date().toLocaleString() }) %>
  <% if (typeof ipAddress !== 'undefined' && ipAddress) { %>
    <%- await include('../partials/info-row', { label: 'From', value: ipAddress }) %>
  <% } %>
  <% if (typeof userAgent !== 'undefined' && userAgent) { %>
    <%- await include('../partials/info-row', { label: 'Device', value: userAgent, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Account', value: adminName, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/alert', {
  tone: 'warning',
  text: 'Wasn’t you? Notify the system administrator immediately at ' + franchise.supportEmail + ' — this could signal unauthorised access.'
}) %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Sign in to console', franchise: franchise, width: '220' }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Stay safe,', team: franchise.franchiseName + ' Security', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
