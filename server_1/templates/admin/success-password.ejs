<%- await include('../layout/email-head', {
  subject: 'Admin password changed successfully',
  preheader: 'Confirmation that your ' + franchise.franchiseName + ' admin password was just updated.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Security update',
  title: 'Admin password changed',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">Dear <%= adminName %>,</p>

<p style="margin:0 0 16px 0;">
  Your password has been successfully changed for your <%= franchise.franchiseName %> admin account.
</p>

<%- await include('../partials/section-open', { heading: 'Change details', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Date', value: changeDate || new Date().toLocaleString() }) %>
  <% if (typeof ipAddress !== 'undefined' && ipAddress) { %>
    <%- await include('../partials/info-row', { label: 'IP address', value: ipAddress }) %>
  <% } %>
  <% if (typeof userAgent !== 'undefined' && userAgent) { %>
    <%- await include('../partials/info-row', { label: 'Device', value: userAgent, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Account', value: adminName, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/alert', {
  tone: 'warning',
  title: 'Didn’t make this change?',
  text: 'Contact the system administrator immediately at ' + franchise.supportEmail + ' — this could indicate unauthorised access.'
}) %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Login to admin portal', franchise: franchise }) %>
<% } %>

<%- await include('../partials/section-open', { heading: 'Security best practices', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Tip 1', value: 'Use a strong, unique password' }) %>
  <%- await include('../partials/info-row', { label: 'Tip 2', value: 'Enable two-factor authentication if available' }) %>
  <%- await include('../partials/info-row', { label: 'Tip 3', value: 'Never share your credentials', last: true }) %>
<%- await include('../partials/section-close') %>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
