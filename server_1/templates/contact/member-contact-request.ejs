<%- await include('../layout/email-head', {
  subject: 'Thanks for getting in touch — ' + franchise.franchiseName,
  preheader: 'Thanks for reaching out — we’ll reply within 1 business day.',
  franchise: franchise,
  icon: '✉'
}) %>

<%- await include('../partials/heading', {
  title: 'Thanks for reaching out, ' + ((typeof memberName !== 'undefined' && memberName) ? memberName : 'friend') + '.',
  lead: 'We’ve received your message and a real human will reply within one business day. Here’s a copy for your records.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Your request' }) %>
  <%- await include('../partials/info-row', { label: 'Reference', value: (typeof requestId !== 'undefined' && requestId) ? requestId : 'N/A' }) %>
  <%- await include('../partials/info-row', { label: 'Subject',   value: subject }) %>
  <%- await include('../partials/info-row', { label: 'Submitted', value: (typeof submittedDate !== 'undefined' && submittedDate) ? submittedDate : new Date().toLocaleString(), last: (typeof message === 'undefined' || !message) }) %>
  <% if (typeof message !== 'undefined' && message) { %>
    <%- await include('../partials/info-row', { label: 'Your message', value: message, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/prose', {
  text: 'Need to add something? Reply to this email and it’ll land on the same ticket.'
}) %>

<%- await include('../partials/signoff', { closing: 'Talk soon,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
