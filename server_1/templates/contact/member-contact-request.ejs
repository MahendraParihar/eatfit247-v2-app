<%- await include('../layout/email-head', {
  subject: 'We’ve received your contact request',
  preheader: 'Thanks for reaching out — we’ll be in touch within 24–48 hours.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Request received',
  title: 'Thanks for contacting us',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">
  Dear <%= (typeof memberName !== 'undefined' && memberName) ? memberName : 'Valued Customer' %>,
</p>

<p style="margin:0 0 24px 0;">
  We’ve received your contact request and appreciate you reaching out to <%= franchise.franchiseName %>.
</p>

<%- await include('../partials/section-open', { heading: 'Your request details', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Request ID',  value: (typeof requestId !== 'undefined' && requestId) ? requestId : 'N/A' }) %>
  <%- await include('../partials/info-row', { label: 'Subject',     value: subject }) %>
  <%- await include('../partials/info-row', { label: 'Submitted on', value: (typeof submittedDate !== 'undefined' && submittedDate) ? submittedDate : new Date().toLocaleString() }) %>
  <% if (typeof message !== 'undefined' && message) { %>
    <%- await include('../partials/info-row', { label: 'Your message', value: message, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Status', value: 'Received', last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/alert', {
  tone: 'info',
  title: 'What happens next?',
  text: 'Our team will review your request and get back to you within 24–48 hours.'
}) %>

<p style="margin:0 0 16px 0;">
  Urgent concern? Reach us directly at
  <a href="mailto:<%= franchise.supportEmail %>" style="color:<%= franchise.brandColor || '#16a34a' %>;text-decoration:none;font-weight:600;"><%= franchise.supportEmail %></a>.
</p>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
