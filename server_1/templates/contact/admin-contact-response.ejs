<%- await include('../layout/email-head', {
  subject: 'Response sent: ' + originalSubject,
  preheader: 'Response delivered to ' + ((typeof memberName !== 'undefined' && memberName) ? memberName : 'the visitor') + ' on “' + originalSubject + '”.',
  franchise: franchise,
  icon: '↩'
}) %>

<%- await include('../partials/heading', {
  title: 'Response delivered',
  lead: 'A reply has been sent to ' + ((typeof memberName !== 'undefined' && memberName) ? memberName : 'the visitor') + ' on the request below. Keep a copy for the ticket trail.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Ticket' }) %>
  <%- await include('../partials/info-row', { label: 'Subject',      value: originalSubject }) %>
  <%- await include('../partials/info-row', { label: 'Responded on', value: (typeof responseDate !== 'undefined' && responseDate) ? responseDate : new Date().toLocaleString() }) %>
  <% if (typeof respondedBy !== 'undefined' && respondedBy) { %>
    <%- await include('../partials/info-row', { label: 'By', value: respondedBy, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Status', value: 'Sent', last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/section-open', { eyebrow: 'Response' }) %>
  <%- await include('../partials/info-row', { label: 'Message', value: responseMessage, last: true }) %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/signoff', { closing: 'Logged,', team: franchise.franchiseName + ' System', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
