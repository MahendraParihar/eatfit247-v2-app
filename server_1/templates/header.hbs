<!-- header.hbs -->
<style>
  .header-container {
    width: 100%;
    height: 60px;
    font-size: 9px;
    color: #393939;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 6px 12px;
    box-sizing: border-box;
  }

  .header-left {
    width: 120px;
  }

  .img-logo img {
    width: 100px;
    height: 36px;
    object-fit: contain;
  }

  .header-right {
    text-align: right;
    line-height: 1.15;
  }

  .company-name {
    font-size: 12px;
    font-weight: 600;
  }
</style>

<header>
  <div class="header-container">
    <div class="header-left">
      {{#if logo}}
        {{#each logo}}
          {{img webUrl "img-logo"}}
        {{/each}}
      {{/if}}
    </div>

    <div class="header-right">
      <div class="company-name">{{companyName}}</div>
      {{#if addressObj}}
        {{addressObj.cityVillage}}, {{addressObj.state}}<br />
        {{addressObj.country}} - {{addressObj.pinCode}}<br />
      {{/if}}
      {{contactNumber}} / {{emailId}}
    </div>
  </div>
</header>