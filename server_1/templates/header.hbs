<!-- header.hbs — shared by invoice (PdfService), diet plan, recipe. pdfHorizontalPadding must match each generator’s page.pdf margins (+ .print-sheet 10px for diet/recipe). -->
<style>
  .header-root {
    width: 100%;
    direction: ltr;
    font-size: 9px;
    color: #393939;
    box-sizing: border-box;
  }

  .header-container {
    width: 100%;
    min-height: 68px;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    padding: 6px {{#if pdfHorizontalPadding}}{{pdfHorizontalPadding}}{{else}}calc(15mm + 10px){{/if}};
    box-sizing: border-box;
    gap: 14px;
  }

  .header-left {
    flex: 0 0 auto;
    width: 165px;
    max-width: 42%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 56px;
  }

  /* Helper renders <img class="img-logo"> — size to match header band, not tiny vs margin */
  img.img-logo {
    display: block;
    max-width: 160px;
    max-height: 58px;
    width: auto;
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  .header-right {
    flex: 1 1 auto;
    min-width: 0;
    text-align: right;
    line-height: 1.2;
    align-self: center;
  }

  .company-name {
    font-size: 12px;
    font-weight: 600;
  }
</style>

<header class="header-root">
  <div class="header-container">
    <div class="header-left" aria-label="Franchise logo">
      {{#if logo}}
        {{#each logo}}
          {{img webUrl "img-logo"}}
        {{/each}}
      {{/if}}
    </div>

    <div class="header-right" aria-label="Franchise details">
      <div class="company-name">{{companyName}}</div>
      {{#if addressObj}}
        {{addressObj.cityVillage}}, {{addressObj.state}}<br />
        {{addressObj.country}} - {{addressObj.pinCode}}<br />
      {{/if}}
      {{contactNumber}} / {{emailId}}
    </div>
  </div>
</header>