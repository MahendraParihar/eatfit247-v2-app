<%
  /*
   * Inline alert/callout — single-line message inside a tinted, bordered container.
   *
   * Locals:
   *   tone   (string, optional) - 'warning' | 'info' | 'success' | 'danger' (default 'warning')
   *   text   (string, required) - message text (escaped)
   *   isHtml (boolean, optional) - render text as raw HTML (default false)
   */
  const _tone   = (typeof tone   !== 'undefined' && tone) ? tone : 'warning';
  const _isHtml = (typeof isHtml !== 'undefined') ? !!isHtml : false;
  const palette = {
    warning: { bg: '#fef3c7', border: '#fde68a', text: '#d97706' },
    info:    { bg: '#dbeafe', border: '#bfdbfe', text: '#1d4ed8' },
    success: { bg: '#dcfce7', border: '#bbf7d0', text: '#15803d' },
    danger:  { bg: '#fee2e2', border: '#fecaca', text: '#b91c1c' },
  };
  const c = palette[_tone] || palette.warning;
-%>
<tr>
  <td class="px" style="padding: 8px 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:<%= c.bg %>; border:1px solid <%= c.border %>; border-radius:10px;">
      <tr>
        <td style="padding:12px 16px; font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:<%= c.text %>; font-weight:500;">
          <% if (_isHtml) { %><%- text %><% } else { %><%= text %><% } %>
        </td>
      </tr>
    </table>
  </td>
</tr>
