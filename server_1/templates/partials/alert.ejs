<%
  /*
   * Inline callout/alert box. Use for security notices, warnings, tips.
   * Locals:
   *   tone   (string, optional) - 'info' | 'warning' | 'success' | 'danger' (default 'info')
   *   title  (string, optional) - bold lead
   *   text   (string, required) - body text (escaped)
   *   isHtml (boolean, optional) - render text as raw HTML (default false)
   */
  const _tone   = (typeof tone   !== 'undefined' && tone) ? tone : 'info';
  const _title  = (typeof title  !== 'undefined' && title) ? title : '';
  const _isHtml = (typeof isHtml !== 'undefined') ? !!isHtml : false;
  const palette = {
    info:    { bg: '#eff6ff', border: '#bfdbfe', text: '#1e3a8a', title: '#1d4ed8' },
    warning: { bg: '#fffbeb', border: '#fde68a', text: '#78350f', title: '#b45309' },
    success: { bg: '#f0fdf4', border: '#bbf7d0', text: '#14532d', title: '#15803d' },
    danger:  { bg: '#fef2f2', border: '#fecaca', text: '#7f1d1d', title: '#b91c1c' },
  };
  const c = palette[_tone] || palette.info;
-%>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:0 0 24px 0;">
  <tr>
    <td style="background-color:<%= c.bg %>;border:1px solid <%= c.border %>;border-left:4px solid <%= c.title %>;border-radius:8px;padding:14px 18px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:<%= c.text %>;">
      <% if (_title) { %>
        <strong style="display:block;color:<%= c.title %>;font-weight:700;margin-bottom:4px;"><%= _title %></strong>
      <% } %>
      <% if (_isHtml) { %><%- text %><% } else { %><%= text %><% } %>
    </td>
  </tr>
</table>
