<%
  /*
   * Closing sign-off row (e.g. "Stay nourished, The EatFit247 Team").
   *
   * Locals:
   *   closing (string, optional) - the salutation line (default "Stay nourished,")
   *   team    (string, optional) - the team name (default "The {franchiseName} Team")
   */
  const _closing = (typeof closing !== 'undefined' && closing) ? closing : 'Stay nourished,';
  const _name    = (franchise && franchise.franchiseName) ? franchise.franchiseName : 'EatFit247';
  const _team    = (typeof team !== 'undefined' && team) ? team : ('The ' + _name + ' Team');
-%>
<tr>
  <td class="px dark-muted" style="padding: 32px 40px 40px; font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:15px; line-height:24px; color:#4b5563;">
    <%= _closing %><br/>
    <strong style="color:#111827;" class="dark-text"><%= _team %></strong>
  </td>
</tr>
