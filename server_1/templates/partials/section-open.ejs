<%
  /*
   * Opens a card-like section (grey background, rounded corners) with an optional heading,
   * then opens an inner table that holds info-row partials.
   * Pair with partials/section-close.ejs.
   * Locals:
   *   heading (string, optional) - small bold heading at the top of the section
   */
  const _heading = (typeof heading !== 'undefined' && heading) ? heading : '';
-%>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="ef-section" style="background-color:#f9fafb;border-radius:10px;margin:8px 0 24px 0;">
  <tr>
    <td style="padding:20px 22px;">
      <% if (_heading) { %>
      <div class="ef-h2" style="margin:0 0 12px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;line-height:1.4;color:#111827;letter-spacing:-0.1px;">
        <%= _heading %>
      </div>
      <% } %>
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="ef-info">
