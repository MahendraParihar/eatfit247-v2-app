<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Diet Plan - {{memberName}}</title>
  <style type="text/css">
    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    html, body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
      color: var(--ink);
      background: #ffffff;
      font-size: 11px;
      margin: 0;
      padding: 0;
    }

    /* =========================
       PRINT LAYOUT (PUPPETEER)
       ========================= */
    /* Sides 10px to match header pdfHorizontalPadding; top slightly less so body sits closer under the PDF header */
    .print-sheet {
      width: 100%;
      padding: 6px 10px 10px 10px;
      page-break-inside: avoid;
    }

    .member-info-table {
      width: 100%;
      border: 1px solid #d3d3d3;
      border-collapse: collapse;
      margin-bottom: 15px;
    }

    .member-info-table td {
      border: 1px solid #d3d3d3;
      padding: 8px 10px;
    }

    .member-info-table td:first-child {
      font-weight: bold;
      width: 20%;
      background-color: #f5f5f5;
    }

    .diet-plan-table {
      width: 100%;
      border: 1px solid #d3d3d3;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    .diet-plan-table th {
      border: 1px solid #d3d3d3;
      padding: 10px;
      background-color: #f5f5f5;
      font-weight: bold;
      text-align: left;
    }

    .diet-plan-table td {
      border: 1px solid #d3d3d3;
      padding: 10px;
      vertical-align: top;
    }

    .diet-plan-table th:nth-child(1),
    .diet-plan-table td:nth-child(1) {
      width: 20%;
    }

    .diet-plan-table th:nth-child(2),
    .diet-plan-table td:nth-child(2) {
      width: 50%;
    }

    .diet-plan-table th:nth-child(3),
    .diet-plan-table td:nth-child(3) {
      width: 30%;
    }

    .recipe-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .recipe-list li {
      margin-bottom: 5px;
      padding-left: 0;
    }

    .recipes-section {
      margin-top: 30px;
      page-break-before: auto;
    }

    .recipes-section h4 {
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    /* =========================
       RECIPE GRID STYLING (from recipe.hbs)
       ========================= */
    :root {
      --ink: #121212;
      --muted: #666;
      --panel: #f8f5f2;
      --border: #e0d7cf;
      --radius: 10px;
    }

    .recipe-grid {
      width: 100%;
      padding: 8px;
      border-radius: var(--radius);
      background: white;
      border: 1px solid var(--border);
      margin-bottom: 20px;
      page-break-inside: avoid;
    }

    /* ---------- ROW 1 ---------- */
    .row1 {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 12px;
    }

    .image-cell,
    .header-cell {
      width: 100%;
    }

    /* ---------- ROW 2 ---------- */
    .row2 {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 12px;
      margin-top: 12px;
    }

    /* =========================
       IMAGE
       ========================= */
    .recipe-image {
      width: 100%;
      height: 180px;
      border-radius: var(--radius);
      overflow: hidden;
      background: #f5f5f5;
    }

    .recipe-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .no-image {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 11px;
      color: #999;
    }

    /* =========================
       HEADER
       ========================= */
    .recipe-header h1 {
      font-size: 18px;
      font-weight: 800;
      margin: 0 0 4px 0;
      line-height: 1.1;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .recipe-description {
      font-size: 10px;
      line-height: 1.3;
      margin: 0 0 6px 0;
    }

    .recipe-meta {
      font-size: 10.5px;
      line-height: 1.3;
    }

    .recipe-meta-item {
      margin-bottom: 2px;
    }

    .recipe-meta-item .label {
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      font-size: 10px;
    }

    /* =========================
       INGREDIENTS
       ========================= */
    .ingredients-cell {
      padding: 6px;
      border-radius: 8px;
      background: var(--panel);
      border: 1px solid var(--panel);
    }

    .ingredients h2 {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      text-align: center;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .ingredients ul {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 10.5px;
    }

    .ingredients li {
      padding: 2px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      line-height: 1.25;
    }

    .ingredients li:last-child {
      border-bottom: none;
    }

    .ingredients-content {
      font-size: 10.5px;
      line-height: 1.25;
    }

    .ingredients-content ul,
    .ingredients-content ol {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .ingredients-content li {
      padding: 2px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .ingredients-content li:last-child {
      border-bottom: none;
    }

    /* =========================
       METHOD
       ========================= */
    .method-cell {
      padding: 6px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .method h2 {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      text-align: center;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .method ol {
      padding-left: 16px;
      margin: 0;
      font-size: 10.5px;
    }

    .method li {
      margin: 2px 0;
      line-height: 1.25;
    }

    .method-content {
      font-size: 10.5px;
      line-height: 1.25;
    }

    .method-content ol,
    .method-content ul {
      padding-left: 16px;
      margin: 0;
    }

    .method-content li {
      margin: 2px 0;
    }

    .method-content p {
      margin: 2px 0;
    }

    @media print {
      .recipe-grid {
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="print-sheet">
  <!-- Member Information Table -->
  <table class="member-info-table">
    <tr>
      <td>Name</td>
      <td>{{memberName}}</td>
    </tr>
    <tr>
      <td>Plan</td>
      <td>Diet Plan - Cycle {{cycleNo}}{{#if planStartDate}} ({{planStartDate}}){{/if}}</td>
    </tr>
  </table>

  <!-- Diet Plan Table -->
  <table class="diet-plan-table">
    <thead>
      <tr>
        <th>Category</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      {{#each diet.dietPlan}}
        {{#if this.dietDetail}}
          <tr>
            <td>{{this.recipeCategory}}</td>
            <td>{{{this.dietDetail}}}</td>
          </tr>
        {{else if this.recipeList}}
          <tr>
            <td>{{this.recipeCategory}}</td>
            <td></td>
          </tr>
        {{/if}}
      {{/each}}
    </tbody>
  </table>

  <!-- Recipes Section -->
  {{#if recipes}}
    {{#if (gt recipes.length 0)}}
      <div class="recipes-section">
        <h4>Recipes:</h4>
        {{#each recipes}}
          <div class="recipe-grid">
            <!-- ROW 1 -->
            <div class="row1">
              <div class="image-cell">
                <div class="recipe-image">
                  {{#if this.imagePath}}
                    {{#if (gt (length this.imagePath) 0)}}
                      {{#with (lookup this.imagePath 0)}}
                        {{#if webUrl}}
                          <img src="{{webUrl}}" alt="{{../this.name}}" />
                        {{else}}
                          <div class="no-image">📷<br>No image</div>
                        {{/if}}
                      {{/with}}
                    {{else}}
                      <div class="no-image">📷<br>No image</div>
                    {{/if}}
                  {{else}}
                    <div class="no-image">📷<br>No image</div>
                  {{/if}}
                </div>
              </div>

              <div class="header-cell">
                <div class="recipe-header">
                  <h1>{{this.name}}</h1>

                  {{#if this.details}}
                    <p class="recipe-description">{{this.details}}</p>
                  {{/if}}

                  <div class="recipe-meta">
                    {{#if this.servingCount}}
                      <div class="recipe-meta-item">
                        <span class="label">Serving:</span>
                        <span class="value">
                          {{this.servingCount}} {{#if (eq this.servingCount 1)}}serving{{else}}servings{{/if}}
                        </span>
                      </div>
                    {{/if}}

                    {{#if this.recipeType}}
                      <div class="recipe-meta-item">
                        <span class="label">Type:</span>
                        <span class="value">{{this.recipeType}}</span>
                      </div>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>

            <!-- ROW 2 -->
            <div class="row2">
              <div class="ingredients-cell">
                <section class="ingredients">
                  <h2>Ingredients</h2>
                  {{#if this.ingredientList}}
                    <ul>
                      {{#each this.ingredientList}}
                        <li>{{{this}}}</li>
                      {{/each}}
                    </ul>
                  {{else}}
                    {{#if this.ingredient}}
                      <div class="ingredients-content">{{{this.ingredient}}}</div>
                    {{else}}
                      <ul><li>No ingredients</li></ul>
                    {{/if}}
                  {{/if}}
                </section>
              </div>

              <div class="method-cell">
                <section class="method">
                  <h2>Method</h2>
                  {{#if this.directionsList}}
                    <ol>
                      {{#each this.directionsList}}
                        <li>{{{this}}}</li>
                      {{/each}}
                    </ol>
                  {{else}}
                    {{#if this.howToMake}}
                      <div class="method-content">{{{this.howToMake}}}</div>
                    {{else}}
                      <ol><li>No method provided</li></ol>
                    {{/if}}
                  {{/if}}
                </section>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}
  </div>
</body>
</html>
