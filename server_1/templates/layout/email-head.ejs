<%
  /*
   * Bulletproof responsive email head — EatFit247 brand system.
   * Opens: DOCTYPE → <head> (Inter font, MSO conditionals, mobile @media at 620px,
   *        dark-mode hints) → <body> → outer wrapper table → brand wordmark header
   *        → card shell (with 4px gradient strip) → optional icon tile.
   * Pair with layout/email-foot.ejs.
   *
   * Locals:
   *   subject    (string)            - <title> + browser tab.
   *   preheader  (string, optional)  - hidden inbox-preview text.
   *   franchise  (object, required)  - { franchiseName, franchiseLogo, brandColor,
   *                                      supportEmail, footerText, address, phone, socials }.
   *   icon       (string, optional)  - single character/glyph for the icon tile (e.g. '★', '⚿', '✓', '₹').
   *                                    Omit to skip the tile entirely.
   */
  const _subject     = (typeof subject     !== 'undefined' && subject)     ? subject     : 'EatFit247';
  const _preheader   = (typeof preheader   !== 'undefined' && preheader)   ? preheader   : '';
  const _brand       = (franchise && franchise.brandColor)    ? franchise.brandColor    : '#f84141';
  const _logo        = (franchise && franchise.franchiseLogo) ? franchise.franchiseLogo : '';
  const _brandName   = (franchise && franchise.franchiseName) ? franchise.franchiseName : 'EatFit247';
  const _icon        = (typeof icon !== 'undefined' && icon)  ? icon : '';
  // Render the EatFit247 wordmark with the middle word in brand colour, or fall back
  // to the franchise name as a single string for white-label tenants.
  const _isEatfit    = /^eatfit247$/i.test(String(_brandName).replace(/\s+/g, ''));
-%>
<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta name="x-apple-disable-message-reformatting"/>
<meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no"/>
<meta name="color-scheme" content="light dark"/>
<meta name="supported-color-schemes" content="light dark"/>
<title><%= _subject %></title>

<!--[if mso]>
<noscript>
<xml>
<o:OfficeDocumentSettings>
<o:PixelsPerInch>96</o:PixelsPerInch>
</o:OfficeDocumentSettings>
</xml>
</noscript>
<style>
  table, td, div, h1, h2, h3, p, a { font-family: Helvetica, Arial, sans-serif !important; }
</style>
<![endif]-->

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" type="text/css"/>

<style type="text/css">
  /* Client resets */
  body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
  table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; border-collapse:collapse; }
  img { -ms-interpolation-mode:bicubic; border:0; outline:none; text-decoration:none; display:block; }
  body { margin:0 !important; padding:0 !important; width:100% !important; background-color:#f9fafb; }
  a { color:<%= _brand %>; text-decoration:none; }
  a:hover { text-decoration:underline; }
  table { border-spacing:0; }
  /* Outlook line-height fix */
  .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height:100%; }
  /* Mobile */
  @media screen and (max-width: 620px) {
    .container { width:100% !important; max-width:100% !important; }
    .px { padding-left:20px !important; padding-right:20px !important; }
    .py-lg { padding-top:28px !important; padding-bottom:28px !important; }
    .h-display { font-size:24px !important; line-height:32px !important; }
    .h-title { font-size:20px !important; line-height:28px !important; }
    .stack, .stack > tbody > tr > td { display:block !important; width:100% !important; box-sizing:border-box; }
    .stack-gap { height:12px !important; }
    .btn-block a { display:block !important; width:auto !important; }
    .hide-mobile { display:none !important; max-height:0 !important; overflow:hidden !important; }
    .show-mobile { display:block !important; max-height:none !important; }
    .meta-grid td { padding-top:6px !important; padding-bottom:6px !important; }
  }
  /* Dark-mode hints (Apple Mail, iOS Mail) — keep palette stable */
  @media (prefers-color-scheme: dark) {
    .dark-bg { background-color:#0b1220 !important; }
    .dark-card { background-color:#111827 !important; }
    .dark-text { color:#f9fafb !important; }
    .dark-muted { color:#9ca3af !important; }
    .dark-border { border-color:#1f2937 !important; }
  }
</style>

</head>
<body style="margin:0; padding:0; width:100%; background-color:#f9fafb; font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;" class="dark-bg">

<!-- Preheader: shown in inbox preview, hidden in body. -->
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#f9fafb; opacity:0;"><%= _preheader %></div>
<div style="display:none; max-height:0; overflow:hidden;">&#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp; &#847; &zwnj; &nbsp;</div>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f9fafb;" class="dark-bg">

  <!-- Brand wordmark, above the card. -->
  <tr>
    <td align="center" class="dark-bg" style="background-color:#f9fafb;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" class="container" style="width:600px; max-width:600px;">
        <tr>
          <td align="center" style="padding: 28px 24px 20px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
              <tr>
                <td align="center" style="font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:22px; font-weight:800; letter-spacing:-0.02em; color:#111827; line-height:1;" class="dark-text">
                  <% if (_logo) { %>
                    <img src="<%= _logo %>" alt="<%= _brandName %>" height="32" style="display:inline-block; max-height:32px; vertical-align:middle; border:0;" />
                  <% } else { %>
                    <span style="display:inline-block; width:10px; height:10px; background:<%= _brand %>; border-radius:999px; margin-right:8px; vertical-align:middle;"></span><span style="vertical-align:middle;"><% if (_isEatfit) { %>Eat<span style="color:<%= _brand %>;">Fit</span>247<% } else { %><%= _brandName %><% } %></span>
                  <% } %>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Card shell. -->
  <tr>
    <td align="center" class="dark-bg" style="background-color:#f9fafb; padding:0 16px 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" class="container dark-card" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:16px; overflow:hidden; border:1px solid #e5e7eb;">

        <!-- 4px brand gradient strip. -->
        <tr><td style="height:4px; line-height:4px; font-size:4px; background:linear-gradient(90deg, #f84141 0%, #FA8547 50%, #4CDAF3 100%); background-color:<%= _brand %>;">&nbsp;</td></tr>

        <% if (_icon) { %>
        <!-- Icon tile -->
        <tr>
          <td class="px" style="padding: 28px 40px 4px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="left">
              <tr>
                <td width="56" height="56" align="center" valign="middle" bgcolor="#fff1f2" style="width:56px; height:56px; background-color:#fff1f2; border-radius:14px; font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:24px; color:<%= _brand %>; font-weight:700; line-height:1;"><%= _icon %></td>
              </tr>
            </table>
          </td>
        </tr>
        <% } %>
