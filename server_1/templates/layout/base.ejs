<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= subject || 'Email' %></title>
  <style>
    /* Email-safe CSS - inline styles preferred */
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
    }
    .email-wrapper {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
    }
    .email-header {
      background-color: <%= franchise.brandColor || '#4CAF50' %>;
      padding: 20px;
      text-align: center;
    }
    .email-header-table {
      width: 100%;
      border-collapse: collapse;
    }
    .email-header-table td {
      vertical-align: middle;
    }
    .logo-cell {
      text-align: left;
      width: 50%;
    }
    .name-cell {
      text-align: right;
      width: 50%;
      color: #ffffff;
      font-size: 18px;
      font-weight: bold;
    }
    .logo-img {
      max-width: 150px;
      max-height: 60px;
      height: auto;
    }
    .email-body {
      padding: 30px 20px;
      line-height: 1.6;
      color: #333333;
    }
    .email-footer {
      background-color: #f9f9f9;
      padding: 20px;
      text-align: center;
      font-size: 12px;
      color: #666666;
      border-top: 1px solid #e0e0e0;
    }
    .footer-text {
      margin-bottom: 10px;
    }
    .footer-email {
      color: <%= franchise.brandColor || '#4CAF50' %>;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <!-- Header -->
    <table class="email-header-table">
      <tr>
        <td class="logo-cell">
          <% if (franchise.franchiseLogo) { %>
            <img src="<%= franchise.franchiseLogo %>" alt="<%= franchise.franchiseName %> Logo" class="logo-img" />
          <% } %>
        </td>
        <td class="name-cell">
          <%= franchise.franchiseName %>
        </td>
      </tr>
    </table>

    <!-- Body Content (injected from child template) -->
    <div class="email-body">
      <%- body %>
    </div>

    <!-- Footer -->
    <div class="email-footer">
      <div class="footer-text">
        <%= franchise.footerText || '© ' + new Date().getFullYear() + ' ' + franchise.franchiseName + '. All rights reserved.' %>
      </div>
      <div>
        <a href="mailto:<%= franchise.supportEmail %>" class="footer-email">
          <%= franchise.supportEmail %>
        </a>
      </div>
    </div>
  </div>
</body>
</html>

