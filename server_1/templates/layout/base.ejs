<%
  /*
   * Single-file layout wrapper. Use when rendering arbitrary `body` HTML through the
   * shared shell without splitting into head/foot.
   * Most templates should instead include layout/email-head + layout/email-foot directly.
   * Locals: subject, preheader, franchise, body
   */
-%>
<%- await include('./email-head', { subject: subject, preheader: (typeof preheader !== 'undefined' ? preheader : ''), franchise: franchise }) %>
<%- body %>
<%- await include('./email-foot', { franchise: franchise }) %>
