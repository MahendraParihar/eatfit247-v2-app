<%
  const _currency = (typeof currency !== 'undefined' && currency) ? currency : '₹';
-%>
<%- await include('../layout/email-head', {
  subject: 'Order confirmed: ' + orderNumber,
  preheader: 'Order ' + orderNumber + ' confirmed — we’ll let you know when it ships.',
  franchise: franchise,
  icon: '▦'
}) %>

<%- await include('../partials/heading', {
  title: 'Order confirmed, ' + memberName + '!',
  lead: 'Thanks for your order. We’re packing things up and will send another note when it leaves the warehouse.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Order summary' }) %>
  <%- await include('../partials/info-row', { label: 'Order #',   value: orderNumber }) %>
  <%- await include('../partials/info-row', { label: 'Placed',    value: orderDate }) %>
  <%- await include('../partials/info-row', {
    label: 'Item',
    value: productName + ((typeof quantity !== 'undefined' && quantity) ? (' × ' + quantity) : '')
  }) %>
  <% if (typeof shippingAddress !== 'undefined' && shippingAddress) { %>
    <%- await include('../partials/info-row', { label: 'Ship to', value: shippingAddress }) %>
  <% } %>
  <% if (typeof estimatedDelivery !== 'undefined' && estimatedDelivery) { %>
    <%- await include('../partials/info-row', { label: 'Est. delivery', value: estimatedDelivery }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Total', value: _currency + totalAmount, last: true, strong: true }) %>
<%- await include('../partials/section-close') %>

<% if (typeof orderTrackingUrl !== 'undefined' && orderTrackingUrl) { %>
  <%- await include('../partials/button', { href: orderTrackingUrl, label: 'Track order', franchise: franchise }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'On its way,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
