<%- await include('../layout/email-head', {
  subject: 'Out for delivery: ' + orderNumber,
  preheader: 'Your order ' + orderNumber + ' is out for delivery today.',
  franchise: franchise,
  icon: '🚚'
}) %>

<%- await include('../partials/heading', {
  title: 'Out for delivery, ' + memberName + '!',
  lead: 'Order ' + orderNumber + ' is on the delivery vehicle and should reach you today. Keep your phone handy in case the courier needs to reach you.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Shipment details' }) %>
  <%- await include('../partials/info-row', { label: 'Order #', value: orderNumber }) %>
  <% if (typeof awbNumber !== 'undefined' && awbNumber) { %>
    <%- await include('../partials/info-row', { label: 'AWB',     value: awbNumber, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<% if (typeof trackingUrl !== 'undefined' && trackingUrl) { %>
  <%- await include('../partials/button', { href: trackingUrl, label: 'Live tracking', franchise: franchise }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Almost there,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
