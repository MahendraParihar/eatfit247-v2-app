<%- await include('../layout/email-head', {
  subject: 'Delivered: ' + orderNumber,
  preheader: 'Your order ' + orderNumber + ' has been delivered.',
  franchise: franchise,
  icon: '✓'
}) %>

<%- await include('../partials/heading', {
  title: 'Delivered, ' + memberName + '!',
  lead: 'Order ' + orderNumber + ' has reached you. We hope everything is in order — reply to this email or get in touch if anything looks off.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Delivery confirmation' }) %>
  <%- await include('../partials/info-row', { label: 'Order #',  value: orderNumber }) %>
  <% if (typeof awbNumber !== 'undefined' && awbNumber) { %>
    <%- await include('../partials/info-row', { label: 'AWB',      value: awbNumber }) %>
  <% } %>
  <% if (typeof deliveredAt !== 'undefined' && deliveredAt) { %>
    <%- await include('../partials/info-row', { label: 'Delivered', value: deliveredAt, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/signoff', { closing: 'Thank you,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
