<%- await include('../layout/email-head', {
  subject: 'Your inquiry has been resolved',
  preheader: 'We’ve responded to your inquiry' + ((typeof inquiryTitle !== 'undefined' && inquiryTitle) ? (': ' + inquiryTitle) : '') + '.',
  franchise: franchise,
  icon: '✓'
}) %>

<%- await include('../partials/heading', {
  title: 'Your inquiry has been resolved.',
  lead: 'Hi ' + memberName + ' — our team has reviewed your inquiry and posted a response. Details below.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Resolution' }) %>
  <% if (typeof inquiryTitle !== 'undefined' && inquiryTitle) { %>
    <%- await include('../partials/info-row', { label: 'Inquiry', value: inquiryTitle }) %>
  <% } %>
  <% if (typeof resolvedBy !== 'undefined' && resolvedBy) { %>
    <%- await include('../partials/info-row', { label: 'Resolved by', value: resolvedBy }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Resolved on', value: resolvedDate || new Date().toLocaleString(), last: (typeof resolutionNote === 'undefined' || !resolutionNote) }) %>
  <% if (typeof resolutionNote !== 'undefined' && resolutionNote) { %>
    <%- await include('../partials/info-row', { label: 'Notes', value: resolutionNote, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/prose', {
  text: 'Anything else? Reply to this email and we’ll pick it up from there.'
}) %>

<%- await include('../partials/signoff', { closing: 'Thanks for being patient,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
