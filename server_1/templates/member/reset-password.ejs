<%
  const _expiry = (typeof expiryHours !== 'undefined' && expiryHours) ? (expiryHours + ' hour' + (expiryHours == 1 ? '' : 's')) : '30 minutes';
-%>
<%- await include('../layout/email-head', {
  subject: 'Reset your ' + franchise.franchiseName + ' password',
  preheader: 'Use the secure link below to reset your password. Expires in ' + _expiry + '.',
  franchise: franchise,
  icon: '⚿'
}) %>

<%- await include('../partials/heading', {
  title: 'Reset your password',
  lead: 'We received a request to reset the password on your ' + franchise.franchiseName + ' account. Tap the button below to choose a new one.'
}) %>

<% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
  <%- await include('../partials/button', { href: resetUrl, label: 'Reset password', franchise: franchise }) %>
<% } %>

<%- await include('../partials/alert', {
  tone: 'warning',
  text: 'This link will expire in ' + _expiry + '. If you didn’t request a reset, you can safely ignore this email — your password stays the same.'
}) %>

<% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
  <%- await include('../partials/prose', {
    text: 'Trouble with the button? Copy and paste this URL into your browser:<br/><span style="word-break:break-all; color:#111827;">' + resetUrl + '</span>',
    isHtml: true
  }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Stay safe,', team: franchise.franchiseName + ' Security', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
