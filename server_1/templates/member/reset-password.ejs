<%- await include('../layout/email-head', {
  subject: 'Reset your ' + franchise.franchiseName + ' password',
  preheader: 'Use the secure link below to choose a new password. Link expires in ' + (typeof expiryHours !== 'undefined' && expiryHours ? expiryHours : 24) + ' hours.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Password reset',
  title: 'Reset your password',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">Dear <%= memberName %>,</p>

<p style="margin:0 0 16px 0;">
  We received a request to reset your password for your <%= franchise.franchiseName %> account.
  Click the button below to choose a new password.
</p>

<% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
  <%- await include('../partials/button', { href: resetUrl, label: 'Reset password', franchise: franchise }) %>

  <p style="margin:0 0 8px 0;font-size:14px;color:#6b7280;">
    Or copy and paste this link into your browser:
  </p>
  <p style="margin:0 0 24px 0;font-size:13px;color:#374151;word-break:break-all;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:10px 12px;">
    <a href="<%= resetUrl %>" style="color:<%= franchise.brandColor || '#16a34a' %>;text-decoration:none;"><%= resetUrl %></a>
  </p>
<% } %>

<%- await include('../partials/alert', {
  tone: 'info',
  title: 'This link expires in ' + (typeof expiryHours !== 'undefined' && expiryHours ? expiryHours : 24) + ' hours.',
  text: 'For your security, request a new reset email after it expires.'
}) %>

<p style="margin:0 0 16px 0;color:#4b5563;">
  Didn't request a reset? You can safely ignore this email or contact
  <a href="mailto:<%= franchise.supportEmail %>" style="color:<%= franchise.brandColor || '#16a34a' %>;text-decoration:none;font-weight:600;"><%= franchise.supportEmail %></a>
  if you have concerns.
</p>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
