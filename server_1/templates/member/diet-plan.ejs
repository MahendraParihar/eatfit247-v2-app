<%- await include('../layout/email-head', {
  subject: 'Your new diet plan is ready',
  preheader: 'A personalized diet plan is waiting for you in your account.',
  franchise: franchise,
  icon: '◑'
}) %>

<%- await include('../partials/heading', {
  title: 'Your new diet plan is ready, ' + memberName + '.',
  lead: 'Your nutritionist has tailored a plan to your body, goals and lifestyle. Open it now to see meals, swaps and macros for the days ahead.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Plan details' }) %>
  <%- await include('../partials/info-row', { label: 'Plan',    value: planName }) %>
  <% if (typeof nutritionistName !== 'undefined' && nutritionistName) { %>
    <%- await include('../partials/info-row', { label: 'Built by', value: nutritionistName }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Assigned', value: assignedDate }) %>
  <% if (typeof planDuration !== 'undefined' && planDuration) { %>
    <%- await include('../partials/info-row', { label: 'Duration', value: planDuration, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Status', value: 'Active', last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<% if (typeof planUrl !== 'undefined' && planUrl) { %>
  <%- await include('../partials/button', { href: planUrl, label: 'View my plan', franchise: franchise }) %>
<% } %>

<%- await include('../partials/prose', {
  text: 'Need a tweak? Reply to this email or message your nutritionist from inside the app — we adapt the plan as you go.'
}) %>

<%- await include('../partials/signoff', { closing: 'Eat well,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
