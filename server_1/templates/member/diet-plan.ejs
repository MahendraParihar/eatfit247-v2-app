<%- await include('../layout/email-head', {
  subject: 'Your diet plan is ready: ' + planName,
  preheader: 'Your personalised diet plan has been assigned and is ready to view.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Diet plan assigned',
  title: 'Your plan is ready, ' + memberName,
  franchise: franchise
}) %>

<p style="margin:0 0 24px 0;">
  Great news — your personalised diet plan has been assigned and is ready for you to view.
  Follow it consistently for the best results.
</p>

<%- await include('../partials/section-open', { heading: 'Plan details', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Plan name', value: planName }) %>
  <% if (typeof nutritionistName !== 'undefined' && nutritionistName) { %>
    <%- await include('../partials/info-row', { label: 'Assigned by', value: nutritionistName }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Assigned on', value: assignedDate }) %>
  <% if (typeof planDuration !== 'undefined' && planDuration) { %>
    <%- await include('../partials/info-row', { label: 'Duration', value: planDuration, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Account', value: franchise.franchiseName, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<% if (typeof planUrl !== 'undefined' && planUrl) { %>
  <%- await include('../partials/button', { href: planUrl, label: 'View your diet plan', franchise: franchise }) %>
<% } %>

<p style="margin:0 0 16px 0;color:#4b5563;">
  Questions or need adjustments? Reach our team at
  <a href="mailto:<%= franchise.supportEmail %>" style="color:<%= franchise.brandColor || '#16a34a' %>;text-decoration:none;font-weight:600;"><%= franchise.supportEmail %></a>.
</p>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
