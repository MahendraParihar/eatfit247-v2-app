<%- await include('../layout/email-head', {
  subject: 'Your ' + franchise.franchiseName + ' password was updated',
  preheader: 'Your ' + franchise.franchiseName + ' password has been updated successfully.',
  franchise: franchise,
  icon: '✓'
}) %>

<%- await include('../partials/heading', {
  title: 'Password updated',
  lead: 'Hi ' + memberName + ' — the password on your ' + franchise.franchiseName + ' account was just changed.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Change details' }) %>
  <%- await include('../partials/info-row', { label: 'When', value: changeDate || new Date().toLocaleString() }) %>
  <% if (typeof ipAddress !== 'undefined' && ipAddress) { %>
    <%- await include('../partials/info-row', { label: 'From', value: ipAddress, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Account', value: franchise.franchiseName, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/alert', {
  tone: 'warning',
  text: 'Wasn’t you? Reach out to ' + franchise.supportEmail + ' immediately — we’ll lock the account and walk you through recovery.'
}) %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Sign in', franchise: franchise }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Stay safe,', team: franchise.franchiseName + ' Security', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
