<h2>Password Changed Successfully</h2>

<p>Dear <%= memberName %>,</p>

<p>Your password has been successfully changed for your <%= franchise.franchiseName %> account.</p>

<p><strong>Change Details:</strong></p>
<ul>
  <li>Date: <%= changeDate || new Date().toLocaleString() %></li>
  <% if (ipAddress) { %>
  <li>IP Address: <%= ipAddress %></li>
  <% } %>
</ul>

<p>If you did not make this change, please contact our support team immediately at <a href="mailto:<%= franchise.supportEmail %>"><%= franchise.supportEmail %></a>.</p>

<% if (loginUrl) { %>
<p>
  <a href="<%= loginUrl %>" style="display: inline-block; padding: 12px 24px; background-color: <%= franchise.brandColor || '#4CAF50' %>; color: #ffffff; text-decoration: none; border-radius: 4px; margin: 20px 0;">
    Login to Your Account
  </a>
</p>
<% } %>

<p>Best regards,<br>The <%= franchise.franchiseName %> Team</p>

