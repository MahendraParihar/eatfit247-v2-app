<%- await include('../layout/email-head', {
  subject: 'Your password has been changed',
  preheader: 'Confirmation that your ' + franchise.franchiseName + ' password was just updated.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Security update',
  title: 'Password changed successfully',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">Dear <%= memberName %>,</p>

<p style="margin:0 0 16px 0;">
  Your password has been successfully changed for your <%= franchise.franchiseName %> account.
</p>

<%- await include('../partials/section-open', { heading: 'Change details', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Date', value: changeDate || new Date().toLocaleString() }) %>
  <% if (typeof ipAddress !== 'undefined' && ipAddress) { %>
    <%- await include('../partials/info-row', { label: 'IP address', value: ipAddress, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Account', value: franchise.franchiseName, last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/alert', {
  tone: 'warning',
  title: 'Didn’t make this change?',
  text: 'Contact our support team immediately at ' + franchise.supportEmail + ' to secure your account.'
}) %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Login to your account', franchise: franchise }) %>
<% } %>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
