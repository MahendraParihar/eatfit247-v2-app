<h2>Plan Invoice</h2>

<p>Dear <%= memberName %>,</p>

<p>Thank you for your purchase! Please find your plan invoice details below.</p>

<div style="background-color: #f9f9f9; padding: 20px; border-radius: 4px; margin: 20px 0;">
  <h3 style="margin-top: 0;">Invoice Details</h3>
  <table style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong>Invoice Number:</strong></td>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><%= invoiceNumber %></td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong>Invoice Date:</strong></td>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><%= invoiceDate %></td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong>Plan Name:</strong></td>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><%= planName %></td>
    </tr>
    <% if (planDuration) { %>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong>Duration:</strong></td>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><%= planDuration %></td>
    </tr>
    <% } %>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong>Amount:</strong></td>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong><%= currency || '₹' %><%= amount %></strong></td>
    </tr>
    <% if (paymentMethod) { %>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><strong>Payment Method:</strong></td>
      <td style="padding: 8px 0; border-bottom: 1px solid #e0e0e0;"><%= paymentMethod %></td>
    </tr>
    <% } %>
    <% if (transactionId) { %>
    <tr>
      <td style="padding: 8px 0;"><strong>Transaction ID:</strong></td>
      <td style="padding: 8px 0;"><%= transactionId %></td>
    </tr>
    <% } %>
  </table>
</div>

<% if (invoiceUrl) { %>
<p>
  <a href="<%= invoiceUrl %>" style="display: inline-block; padding: 12px 24px; background-color: <%= franchise.brandColor || '#4CAF50' %>; color: #ffffff; text-decoration: none; border-radius: 4px; margin: 20px 0;">
    Download Invoice
  </a>
</p>
<% } %>

<p>If you have any questions about this invoice, please contact our support team at <a href="mailto:<%= franchise.supportEmail %>"><%= franchise.supportEmail %></a>.</p>

<p>Best regards,<br>The <%= franchise.franchiseName %> Team</p>

