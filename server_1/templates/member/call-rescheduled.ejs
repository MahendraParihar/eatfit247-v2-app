<%- await include('../layout/email-head', {
  subject: 'Your call has been rescheduled',
  preheader: 'Your consultation has been rescheduled to ' + newCallDate + ' at ' + newCallTime + '.',
  franchise: franchise,
  icon: '⟲'
}) %>

<%- await include('../partials/heading', {
  title: 'Your call has been rescheduled.',
  lead: 'Hi ' + memberName + ' — here’s the new time. Everything else stays the same.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'New time' }) %>
  <%- await include('../partials/info-row', { label: 'Date', value: newCallDate }) %>
  <%- await include('../partials/info-row', { label: 'Time', value: newCallTime + ((typeof timezone !== 'undefined' && timezone) ? ' (' + timezone + ')' : '') }) %>
  <% if (typeof nutritionistName !== 'undefined' && nutritionistName) { %>
    <%- await include('../partials/info-row', { label: 'With', value: nutritionistName, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Status', value: 'Confirmed', last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<% if (typeof oldCallDate !== 'undefined' && oldCallDate) { %>
  <%- await include('../partials/section-open', { eyebrow: 'Previously' }) %>
    <%- await include('../partials/info-row', { label: 'Was', value: oldCallDate + ((typeof oldCallTime !== 'undefined' && oldCallTime) ? (' at ' + oldCallTime) : ''), last: true }) %>
  <%- await include('../partials/section-close') %>
<% } %>

<% if (typeof meetingLink !== 'undefined' && meetingLink) { %>
  <%- await include('../partials/button', { href: meetingLink, label: 'Join call', franchise: franchise }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'See you then,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
