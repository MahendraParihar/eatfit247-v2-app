<%
  const _currency = (typeof currency !== 'undefined' && currency) ? currency : '₹';
-%>
<%- await include('../layout/email-head', {
  subject: 'Invoice ' + invoiceNumber + ' — ' + franchise.franchiseName,
  preheader: productName + ' — ' + _currency + amount + ' paid. Invoice attached.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Receipt',
  title: 'Thanks for your purchase',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">Dear <%= memberName %>,</p>

<p style="margin:0 0 24px 0;">
  Your payment was successful. Here are the details of your product invoice.
</p>

<%- await include('../partials/section-open', { heading: 'Invoice details', franchise: franchise }) %>
  <%- await include('../partials/info-row', { label: 'Invoice number', value: invoiceNumber }) %>
  <%- await include('../partials/info-row', { label: 'Invoice date',   value: invoiceDate }) %>
  <%- await include('../partials/info-row', { label: 'Product',        value: productName }) %>
  <% if (typeof productQuantity !== 'undefined' && productQuantity) { %>
    <%- await include('../partials/info-row', { label: 'Quantity', value: productQuantity }) %>
  <% } %>
  <% if (typeof paymentMethod !== 'undefined' && paymentMethod) { %>
    <%- await include('../partials/info-row', { label: 'Payment method', value: paymentMethod }) %>
  <% } %>
  <% if (typeof transactionId !== 'undefined' && transactionId) { %>
    <%- await include('../partials/info-row', { label: 'Transaction ID', value: transactionId }) %>
  <% } %>
  <%- await include('../partials/info-row', {
    label: 'Amount paid',
    value: '<span style="font-size:18px;color:' + (franchise.brandColor || '#16a34a') + ';font-weight:700;">' + _currency + amount + '</span>',
    isHtml: true,
    last: true
  }) %>
<%- await include('../partials/section-close') %>

<% if (typeof invoiceUrl !== 'undefined' && invoiceUrl) { %>
  <%- await include('../partials/button', { href: invoiceUrl, label: 'Download invoice (PDF)', franchise: franchise }) %>
<% } %>

<p style="margin:0 0 16px 0;color:#4b5563;">
  Questions about this invoice? Reach us at
  <a href="mailto:<%= franchise.supportEmail %>" style="color:<%= franchise.brandColor || '#16a34a' %>;text-decoration:none;font-weight:600;"><%= franchise.supportEmail %></a>.
</p>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
