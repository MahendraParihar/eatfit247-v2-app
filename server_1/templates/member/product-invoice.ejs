<%
  const _currency = (typeof currency !== 'undefined' && currency) ? currency : '₹';
-%>
<%- await include('../layout/email-head', {
  subject: 'Invoice ' + invoiceNumber + ' — ' + franchise.franchiseName,
  preheader: 'Tax invoice for invoice ' + invoiceNumber + ' — ' + _currency + amount + ' paid.',
  franchise: franchise,
  icon: '§'
}) %>

<%- await include('../partials/heading', {
  title: 'Here’s your invoice.',
  lead: 'Thanks, ' + memberName + '. Payment was successful — keep this email for your records.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Invoice details' }) %>
  <%- await include('../partials/info-row', { label: 'Invoice #', value: invoiceNumber }) %>
  <%- await include('../partials/info-row', { label: 'Date',      value: invoiceDate }) %>
  <%- await include('../partials/info-row', { label: 'Member',    value: memberName }) %>
  <%- await include('../partials/info-row', {
    label: 'Item',
    value: productName + ((typeof productQuantity !== 'undefined' && productQuantity) ? (' × ' + productQuantity) : '')
  }) %>
  <% if (typeof paymentMethod !== 'undefined' && paymentMethod) { %>
    <%- await include('../partials/info-row', { label: 'Payment method', value: paymentMethod }) %>
  <% } %>
  <% if (typeof transactionId !== 'undefined' && transactionId) { %>
    <%- await include('../partials/info-row', { label: 'Transaction ID', value: transactionId, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Status', value: 'Paid', last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<%- await include('../partials/section-open', { eyebrow: 'Charges' }) %>
  <%- await include('../partials/info-row', { label: productName, value: _currency + amount, last: true, strong: true }) %>
<%- await include('../partials/section-close') %>

<% if (typeof invoiceUrl !== 'undefined' && invoiceUrl) { %>
  <%- await include('../partials/button', { href: invoiceUrl, label: 'Download invoice (PDF)', franchise: franchise, width: '260' }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Thank you,', team: franchise.franchiseName + ' Billing', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
