<%- await include('../layout/email-head', {
  subject: 'Your call has been cancelled',
  preheader: 'Your consultation scheduled for ' + callDate + ' at ' + callTime + ' has been cancelled.',
  franchise: franchise,
  icon: '✕'
}) %>

<%- await include('../partials/heading', {
  title: 'Your call has been cancelled.',
  lead: 'Hi ' + memberName + ' — the consultation below won’t take place. You can book a new one any time.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Cancelled slot' }) %>
  <%- await include('../partials/info-row', { label: 'Was on', value: callDate }) %>
  <%- await include('../partials/info-row', { label: 'At',     value: callTime }) %>
  <% if (typeof cancellationReason !== 'undefined' && cancellationReason) { %>
    <%- await include('../partials/info-row', { label: 'Reason', value: cancellationReason }) %>
  <% } %>
  <%- await include('../partials/info-row', { label: 'Cancelled on', value: cancelledDate || new Date().toLocaleString(), last: true }) %>
<%- await include('../partials/section-close') %>

<% if (typeof rescheduleUrl !== 'undefined' && rescheduleUrl) { %>
  <%- await include('../partials/button', { href: rescheduleUrl, label: 'Book a new call', franchise: franchise, width: '200' }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Talk soon,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
