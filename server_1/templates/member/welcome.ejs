<%- await include('../layout/email-head', {
  subject: 'Welcome to ' + franchise.franchiseName,
  preheader: 'Your journey to a healthier you starts here.',
  franchise: franchise,
  icon: '★'
}) %>

<%- await include('../partials/heading', {
  title: 'Welcome, ' + memberName + '.',
  lead: 'We’re so glad you’re here. Your account is ready — let’s set you up for your healthiest year yet.'
}) %>

<%- await include('../partials/prose', {
  text: franchise.franchiseName + ' pairs you with a real nutritionist, builds a diet plan around your body and lifestyle, and keeps you on track with weekly check-ins.'
}) %>

<%- await include('../partials/prose', {
  text: 'Once your profile is in, your nutritionist will craft your first diet plan within 24 hours.',
  tight: true
}) %>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Open my account', franchise: franchise }) %>
<% } %>

<%- await include('../partials/signoff', { closing: 'Stay nourished,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
