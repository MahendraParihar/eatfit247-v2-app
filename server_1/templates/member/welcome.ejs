<%- await include('../layout/email-head', {
  subject: 'Welcome to ' + franchise.franchiseName,
  preheader: 'Your ' + franchise.franchiseName + ' account is ready — let’s get started.',
  franchise: franchise
}) %>

<%- await include('../partials/heading', {
  eyebrow: 'Welcome aboard',
  title: 'Welcome to ' + franchise.franchiseName + '!',
  franchise: franchise
}) %>

<p style="margin:0 0 16px 0;">Dear <%= memberName %>,</p>

<p style="margin:0 0 16px 0;">
  We're thrilled to have you join the <%= franchise.franchiseName %> family.
  Your account has been successfully created and you can now start your journey
  towards a healthier lifestyle.
</p>

<% if (typeof loginUrl !== 'undefined' && loginUrl) { %>
  <%- await include('../partials/button', { href: loginUrl, label: 'Login to your account', align: 'left', franchise: franchise }) %>
<% } %>

<p style="margin:0 0 16px 0;color:#4b5563;">
  Have questions? Reach our support team any time at
  <a href="mailto:<%= franchise.supportEmail %>" style="color:<%= franchise.brandColor || '#16a34a' %>;text-decoration:none;font-weight:600;"><%= franchise.supportEmail %></a>.
</p>

<p style="margin:0;color:#4b5563;">
  Best regards,<br/>
  <strong style="color:#111827;">The <%= franchise.franchiseName %> Team</strong>
</p>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
