<%- await include('../layout/email-head', {
  subject: 'Call confirmed for ' + callDate + ' at ' + callTime,
  preheader: 'Confirmed: ' + callDate + ' at ' + callTime + ((typeof nutritionistName !== 'undefined' && nutritionistName) ? (' with ' + nutritionistName) : '') + '.',
  franchise: franchise,
  icon: '◐'
}) %>

<%- await include('../partials/heading', {
  title: 'You’re booked in, ' + memberName + '.',
  lead: 'Here are the details for your upcoming consultation. We’ll send a reminder one hour before.'
}) %>

<%- await include('../partials/section-open', { eyebrow: 'Call details' }) %>
  <%- await include('../partials/info-row', { label: 'Date', value: callDate }) %>
  <%- await include('../partials/info-row', { label: 'Time', value: callTime + ((typeof timezone !== 'undefined' && timezone) ? ' (' + timezone + ')' : '') }) %>
  <% if (typeof nutritionistName !== 'undefined' && nutritionistName) { %>
    <%- await include('../partials/info-row', { label: 'With', value: nutritionistName }) %>
  <% } %>
  <% if (typeof callType !== 'undefined' && callType) { %>
    <%- await include('../partials/info-row', { label: 'Type', value: callType, last: true }) %>
  <% } else { %>
    <%- await include('../partials/info-row', { label: 'Status', value: 'Confirmed', last: true }) %>
  <% } %>
<%- await include('../partials/section-close') %>

<% if (typeof meetingLink !== 'undefined' && meetingLink) { %>
  <%- await include('../partials/button', { href: meetingLink, label: 'Join call', franchise: franchise }) %>
<% } %>

<%- await include('../partials/prose', {
  text: 'Tip: join 5 minutes early, have a stable connection, and jot down anything you want to discuss.'
}) %>

<%- await include('../partials/signoff', { closing: 'See you soon,', franchise: franchise }) %>

<%- await include('../layout/email-foot', { franchise: franchise }) %>
