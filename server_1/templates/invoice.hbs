<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{invoice.header.title}}</title>
  <style type="text/css">
    @page {
      size: A4;
      margin: 10mm;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Arial', 'Helvetica', sans-serif;
      font-size: 9px;
      color: #333;
      line-height: 1.3;
      padding: 0;
      margin: 0;
    }

    @media print {
      body {
        margin: 0;
        padding: 0;
      }
    }

    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      border-bottom: 1px solid #000;
      padding-bottom: 4px;
    }

    .invoice-header-logo-cell {
      width: 100px;
      display: flex;
      align-items: center;
    }

    .invoice-header-logo {
      max-width: 100px;
      max-height: 40px;
      object-fit: contain;
    }

    .invoice-header-title {
      flex: 1;
      text-align: center;
      font-size: 16px;
      font-weight: bold;
    }

    .invoice-header-invoice-meta {
      display: flex;
      flex-direction: column;
      font-size: 8px;
    }

    .invoice-meta-item {
      display: flex;
      flex-direction: row;
      margin-bottom: 2px;
    }

    .invoice-header-franchise {
      text-align: right;
      font-size: 11px;
      font-weight: bold;
    }

    .invoice-meta-label {
      font-weight: bold;
      margin-right: 4px;
    }

    .parties-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .party-block {
      width: 48%;
      border: 1px solid #ddd;
      padding: 6px;
      background-color: #f9f9f9;
    }

    .party-title {
      font-weight: bold;
      font-size: 10px;
      margin-bottom: 4px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 2px;
    }

    .party-name {
      font-weight: bold;
      font-size: 9px;
      margin-bottom: 3px;
    }

    .party-address {
      margin-bottom: 2px;
      line-height: 1.3;
      font-size: 8px;
    }

    .party-contact {
      margin-top: 4px;
      font-size: 8px;
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
      font-size: 8px;
    }

    .items-table thead {
      background-color: #333;
      color: #fff;
    }

    .items-table th {
      padding: 4px 3px;
      text-align: left;
      font-weight: bold;
      border: 1px solid #ddd;
      font-size: 8px;
    }

    .items-table td {
      padding: 3px;
      border: 1px solid #ddd;
      font-size: 8px;
    }

    .items-table tbody tr:nth-child(even) {
      background-color: #f9f9f9;
    }

    .text-right {
      text-align: right;
    }

    .text-center {
      text-align: center;
    }

    .summary-section {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 8px;
    }

    .summary-table {
      width: 320px;
      border-collapse: collapse;
      font-size: 8px;
    }

    .summary-table td {
      padding: 3px 8px;
      border: 1px solid #ddd;
      font-size: 8px;
    }

    .summary-table td:first-child {
      font-weight: bold;
      background-color: #f9f9f9;
      width: 60%;
    }

    .summary-table td:last-child {
      text-align: right;
      width: 40%;
    }

    .summary-table .total-row {
      font-weight: bold;
      font-size: 9px;
      background-color: #333;
      color: #fff;
    }

    .tax-note {
      margin-top: 4px;
      padding: 4px 6px;
      background-color: #fff3cd;
      border-left: 3px solid #ffc107;
      font-size: 8px;
      font-style: italic;
    }

    .qr-section {
      display: flex;
      justify-content: flex-end;
      align-items: flex-start;
      margin-top: 8px;
      margin-bottom: 8px;
    }

    .qr-block {
      text-align: center;
      padding: 6px;
      border: 1px solid #ddd;
      background-color: #f9f9f9;
    }

    .qr-code-img {
      width: 80px;
      height: 80px;
      margin-bottom: 4px;
    }

    .qr-label {
      font-size: 7px;
      color: #666;
    }

    .payment-info {
      margin-top: 6px;
      padding: 4px 6px;
      background-color: #e7f3ff;
      border-left: 3px solid #2196F3;
      font-size: 8px;
      line-height: 1.3;
    }

    .footer {
      margin-top: 8px;
      padding-top: 6px;
      border-top: 1px solid #ddd;
      font-size: 7px;
      color: #666;
      text-align: center;
    }

    .no-tax-label {
      color: #666;
      font-style: italic;
    }

    .three-column-section {
      display: flex;
      justify-content: space-between;
      margin-top: 6px;
      margin-bottom: 6px;
      padding-top: 6px;
      border-top: 1px solid #e0e0e0;
      gap: 8px;
    }

    .column-terms {
      width: 35%;
      padding: 0 6px 0 0;
      border-right: 1px solid #e8e8e8;
      padding-right: 8px;
    }

    .column-qr {
      width: 30%;
      padding: 0 6px;
      text-align: center;
      border-right: 1px solid #e8e8e8;
      padding-right: 8px;
    }

    .column-notes {
      width: 35%;
      padding: 0 0 0 6px;
    }

    .column-title {
      font-weight: bold;
      font-size: 9px;
      margin-bottom: 4px;
      color: #555;
      padding-bottom: 2px;
    }

    .column-content {
      font-size: 8px;
      line-height: 1.3;
    }

    .column-content ul {
      margin: 2px 0 0 15px;
      line-height: 1.4;
      padding: 0;
    }

    .tax-summary-section {
      margin-bottom: 10px;
      margin-top: 8px;
    }

    .tax-summary-title {
      font-size: 10px;
      font-weight: bold;
      margin-bottom: 4px;
      color: #333;
    }

    .tax-summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8px;
      margin-bottom: 8px;
    }

    .tax-summary-table thead {
      background-color: #333;
      color: #fff;
    }

    .tax-summary-table th {
      padding: 4px 3px;
      text-align: left;
      font-weight: bold;
      border: 1px solid #ddd;
      font-size: 8px;
    }

    .tax-summary-table td {
      padding: 3px;
      border: 1px solid #ddd;
      font-size: 8px;
    }

    .tax-summary-table tbody tr:nth-child(even) {
      background-color: #f9f9f9;
    }
  </style>
</head>
<body>
<!-- Invoice Header -->
<div class="invoice-header">
  <div class="invoice-header-franchise">
    {{#if invoice.header.brandName}}{{invoice.header.brandName}}{{else}}{{invoice.seller.name}}{{/if}}
  </div>
  <div class="invoice-header-title">{{invoice.header.title}}</div>
  <div class="invoice-header-invoice-meta">
    <div class="invoice-meta-item">
      <span class="invoice-meta-label">Invoice No:</span>
      <span>{{invoice.header.invoiceNumber}}</span>
    </div>
    <div class="invoice-meta-item">
      <span class="invoice-meta-label">Invoice Date:</span>
      <span>{{formatDate invoice.header.invoiceDate}}</span>
    </div>
    {{#if invoice.header.playOfSupply}}
      <div class="invoice-meta-item">
        <span class="invoice-meta-label">Place of Supply:</span>
        <span>{{formatDate invoice.header.playOfSupply}}</span>
      </div>
    {{/if}}
  </div>
</div>

<!-- Seller and Buyer Information -->
<div class="parties-section">
  <!-- Seller Block -->
  <div class="party-block">
    <div class="party-title">Sold By</div>
    <div class="party-name">{{invoice.seller.name}}</div>
    <div class="party-address">
      {{invoice.seller.address.line1}}<br>
      {{#if invoice.seller.address.line2}}{{invoice.seller.address.line2}}<br>{{/if}}
      {{invoice.seller.address.city}}{{#if invoice.seller.address.state}}, {{invoice.seller.address.state}}{{/if}}<br>
      {{invoice.seller.address.postalCode}}<br>
      {{invoice.seller.address.country}}
    </div>
    {{#if invoice.seller.taxId}}
      <div class="party-contact">
        <strong>{{invoice.seller.taxIdLabel}}:</strong> {{invoice.seller.taxId}}
      </div>
    {{/if}}
    {{#if invoice.seller.phone}}
      <div class="party-contact">
        <strong>Phone:</strong> {{invoice.seller.phone}}
      </div>
    {{/if}}
    {{#if invoice.seller.email}}
      <div class="party-contact">
        <strong>Email:</strong> {{invoice.seller.email}}
      </div>
    {{/if}}
  </div>

  <!-- Buyer Block -->
  <div class="party-block">
    <div class="party-title">Bill To</div>
    <div class="party-name">{{invoice.buyer.name}}</div>
    <div class="party-address">
      {{invoice.buyer.address.line1}}<br>
      {{#if invoice.buyer.address.line2}}{{invoice.buyer.address.line2}}<br>{{/if}}
      {{invoice.buyer.address.city}}{{#if invoice.buyer.address.state}}, {{invoice.buyer.address.state}}{{/if}}<br>
      {{invoice.buyer.address.postalCode}}<br>
      {{invoice.buyer.address.country}}
    </div>
    {{#if invoice.buyer.taxId}}
      <div class="party-contact">
        <strong>{{invoice.buyer.taxIdLabel}}:</strong> {{invoice.buyer.taxId}}
      </div>
    {{/if}}
    {{#if invoice.buyer.phone}}
      <div class="party-contact">
        <strong>Phone:</strong> {{invoice.buyer.phone}}
      </div>
    {{/if}}
    {{#if invoice.buyer.email}}
      <div class="party-contact">
        <strong>Email:</strong> {{invoice.buyer.email}}
      </div>
    {{/if}}
    {{#if invoice.buyer.businessRegNumber}}
      <div class="party-contact">
        <strong>GST No:</strong> {{invoice.buyer.businessRegNumber}}
      </div>
    {{/if}}
  </div>
</div>

<!-- Items Table -->
<table class="items-table">
  <thead>
  <tr>
    <th style="width: 5%;">#</th>
    <th style="width: 30%;">Description</th>
    {{#if showSacColumn}}
      <th style="width: 8%;" class="text-center">SAC</th>
    {{/if}}
    {{#if showHsnColumn}}
      <th style="width: 8%;" class="text-center">HSN</th>
    {{/if}}
    <th style="width: 6%;" class="text-center">Qty</th>
    <th style="width: 8%;" class="text-right">Price/Unit</th>
    <th style="width: 8%;" class="text-right">Disc.</th>
    <th style="width: 8%;" class="text-right">Tax (%)</th>
    <th style="width: 8%;" class="text-right">Tax Amt</th>
    <th style="width: 10%;" class="text-right">Amount ({{invoice.header.currency}})</th>
  </tr>
  </thead>
  <tbody>
  {{#each invoice.items}}
    <tr>
      <td>{{increment @index}}</td>
      <td>{{this.description}}</td>
      {{#if ../showSacColumn}}
        <td class="text-center">{{#if this.sacCode}}{{this.sacCode}}{{else}}-{{/if}}</td>
      {{/if}}
      {{#if ../showHsnColumn}}
        <td class="text-center">{{#if this.hsnCode}}{{this.hsnCode}}{{else}}-{{/if}}</td>
      {{/if}}
      <td class="text-center">{{this.qty}}</td>
      <td class="text-right">{{formatCurrency this.unitPrice }}</td>
      <td class="text-right">{{#if this.discount}}{{formatCurrency this.discount }}{{else}}-{{/if}}</td>
      <td class="text-right">{{#if this.taxPercentage}}{{this.taxPercentage }}{{else}}-{{/if}}</td>
      <td class="text-right">{{#if this.taxAmount}}{{formatCurrency this.taxAmount }}{{else}}-{{/if}}</td>
      <td class="text-right">{{#if this.totalAmount}}{{formatCurrency this.totalAmount }}{{else}}-{{/if}}</td>
    </tr>
  {{/each}}
  </tbody>
</table>

<!-- Tax Summary Section -->
{{#if isGstTaxType}}
{{#if gstTaxSummary}}
{{#if (gt (length gstTaxSummary) 0)}}
<div class="tax-summary-section">
  <h3 class="tax-summary-title">Tax Summary</h3>
  <table class="tax-summary-table">
    <thead>
      <tr>
        <th style="width: 15%;" class="text-center">GST Rate</th>
        <th style="width: 25%;" class="text-right">Taxable Amount</th>
        <th style="width: 15%;" class="text-right">CGST</th>
        <th style="width: 15%;" class="text-right">SGST</th>
        <th style="width: 15%;" class="text-right">IGST</th>
        <th style="width: 15%;" class="text-right">Total Tax</th>
      </tr>
    </thead>
    <tbody>
      {{#each gstTaxSummary}}
        <tr>
          <td class="text-center">{{this.gstRate}}%</td>
          <td class="text-right">{{formatCurrency this.taxableAmount}}</td>
          <td class="text-right">
            {{#if this.cgst}}
              {{formatCurrency this.cgst}}
            {{else}}
              -
            {{/if}}
          </td>
          <td class="text-right">
            {{#if this.sgst}}
              {{formatCurrency this.sgst}}
            {{else}}
              -
            {{/if}}
          </td>
          <td class="text-right">
            {{#if this.igst}}
              {{formatCurrency this.igst}}
            {{else}}
              -
            {{/if}}
          </td>
          <td class="text-right">{{formatCurrency this.totalTax}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{/if}}
{{/if}}
{{/if}}

<!-- Summary Section -->
<div class="summary-section">
  <table class="summary-table">
    <tr>
      <td>Subtotal</td>
      <td class="text-right">{{formatCurrency invoice.pricing.subtotal}}</td>
    </tr>
    {{#if invoice.pricing.discount}}
      <tr>
        <td>Discount</td>
        <td class="text-right">-{{formatCurrency invoice.pricing.discount}}</td>
      </tr>
    {{/if}}
    {{#if invoice.pricing.taxableAmount}}
      <tr>
        <td><strong>Taxable Amount</strong></td>
        <td class="text-right"><strong>{{formatCurrency invoice.pricing.taxableAmount }}</strong></td>
      </tr>
    {{/if}}
    {{#if invoice.pricing.taxAmount}}
      <tr>
        <td><strong>Tax</strong></td>
        <td class="text-right"><strong>{{formatCurrency invoice.pricing.taxAmount }}</strong></td>
      </tr>
    {{/if}}
    {{#if invoice.pricing.totalAmount}}
      <tr class="total-row">
        <td>{{invoice.total.label}}</td>
        <td class="text-right">{{formatCurrency invoice.pricing.totalAmount}}</td>
      </tr>
    {{/if}}
  </table>
</div>

<!-- Three Column Section: Terms, QR Code, Notes -->
<div class="three-column-section">
  <!-- Terms and Conditions Column -->
  <div class="column-terms">
    <div class="column-title">Terms and Conditions</div>
    <div class="column-content">
      {{#if invoice.termsAndConditions}}
        <ul>
          {{#each invoice.termsAndConditions}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}
        <ul>
          <li>All payments are non-refundable and non-transferable under any circumstances.</li>
          <li>Payment confirms acceptance of EatFit247's terms and service validity conditions.</li>
        </ul>
      {{/if}}
    </div>
  </div>

  <!-- QR Code Column -->
  <div class="column-qr">
    {{#if showQrCode}}
      {{#if qrCodeImage}}
        <img src="{{qrCodeImage}}" alt="QR Code" class="qr-code-img" />
      {{/if}}
      {{#if invoice.qrCode.label}}
        <div class="qr-label">{{invoice.qrCode.label}}</div>
      {{/if}}
    {{/if}}
  </div>

  <!-- Notes Column -->
  <div class="column-notes">
    <div class="column-title">Notes</div>
    <div class="column-content">
      {{#if invoice.notes}}
        {{invoice.notes}}
      {{else}}
        <ul>
          <li>Discount allocated proportionally per item</li>
          <li>Tax calculated post discount</li>
        </ul>
      {{/if}}
    </div>
  </div>
</div>

<!-- Tax Note -->
{{#if invoice.tax.note}}
  <div class="tax-note">
    <strong>Note:</strong> {{invoice.tax.note}}
  </div>
{{/if}}

<!-- Payment Information -->
<div class="payment-info">
  <strong>Payment Information:</strong><br>
  <strong>Status:</strong> {{invoice.payment.status}}<br>
  <strong>Method:</strong> {{#each invoice.payment.methods}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
  {{#if invoice.payment.transactionId}}<br><strong>Transaction ID:</strong> {{invoice.payment.transactionId}}{{/if}}
</div>

<!-- Footer -->
{{#if invoice.footer.legalNote}}
  <div class="footer">
    {{invoice.footer.legalNote}}
  </div>
{{/if}}
</body>
</html>

