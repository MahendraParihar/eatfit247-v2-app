<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{name}} — Recipe Card</title>

  <style>
    :root {
      --ink: #121212;
      --muted: #666;
      --panel: #f8f5f2;
      --border: #e0d7cf;
      --radius: 10px;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    html, body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
      color: var(--ink);
      background: #ffffff;
      font-size: 11px;
      margin: 0;
      padding: 0;
    }

    /* =========================
       PRINT LAYOUT (PUPPETEER)
       ========================= */
    .print-sheet {
      width: 100%;
      padding: 10px;
      page-break-inside: avoid;
    }

    /* =========================
       RECIPE GRID (NO TABLE)
       ========================= */
    .recipe-grid {
      width: 100%;
      padding: 8px;
      border-radius: var(--radius);
      background: white;
      page-break-inside: avoid;
    }

    /* ---------- ROW 1 ---------- */
    .row1 {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 12px;
    }

    .image-cell,
    .header-cell {
      width: 100%;
    }

    /* ---------- ROW 2 ---------- */
    .row2 {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 12px;
      margin-top: 12px;
    }

    /* =========================
       IMAGE
       ========================= */
    .recipe-image {
      width: 100%;
      height: 180px;
      border-radius: var(--radius);
      overflow: hidden;
      background: #f5f5f5;
    }

    .recipe-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .no-image {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 11px;
      color: #999;
    }

    /* =========================
       HEADER
       ========================= */
    .recipe-header h1 {
      font-size: 18px;
      font-weight: 800;
      margin: 0 0 4px 0;
      line-height: 1.1;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .recipe-description {
      font-size: 10px;
      line-height: 1.3;
      margin: 0 0 6px 0;
    }

    .recipe-meta {
      font-size: 10.5px;
      line-height: 1.3;
    }

    .recipe-meta-item {
      margin-bottom: 2px;
    }

    .recipe-meta-item .label {
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      font-size: 10px;
    }

    /* =========================
       INGREDIENTS
       ========================= */
    .ingredients-cell {
      padding: 6px;
      border-radius: 8px;
      background: var(--panel);
      border: 1px solid var(--panel);
    }

    .ingredients h2 {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      text-align: center;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .ingredients ul {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 10.5px;
    }

    .ingredients li {
      padding: 2px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      line-height: 1.25;
    }

    .ingredients li:last-child {
      border-bottom: none;
    }

    /* =========================
       METHOD
       ========================= */
    .method-cell {
      padding: 6px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .method h2 {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      text-align: center;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .method ol {
      padding-left: 16px;
      margin: 0;
      font-size: 10.5px;
    }

    .method li {
      margin: 2px 0;
      line-height: 1.25;
    }

    /* =========================
       SCREEN PREVIEW
       ========================= */
    @media screen {
      .recipe-grid {
        border: 1px solid #f0f0f0;
        margin-bottom: 24px;
      }

      .recipe-header h1 {
        font-size: 24px;
      }

      .ingredients ul,
      .method ol {
        font-size: 12px;
      }
    }
  </style>
</head>

<body>
  <div class="print-sheet">
    <div class="recipe-grid">

      <!-- ROW 1 -->
      <div class="row1">
        <div class="image-cell">
          <div class="recipe-image">
            {{#if imagePath}}
              {{#if (gt (length imagePath) 0)}}
                {{#with (lookup imagePath 0)}}
                  {{#if webUrl}}
                    <img src="{{webUrl}}" alt="{{../name}}" />
                  {{else}}
                    <div class="no-image">📷<br>No image</div>
                  {{/if}}
                {{/with}}
              {{else}}
                <div class="no-image">📷<br>No image</div>
              {{/if}}
            {{else}}
              <div class="no-image">📷<br>No image</div>
            {{/if}}
          </div>
        </div>

        <div class="header-cell">
          <div class="recipe-header">
            <h1>{{name}}</h1>

            {{#if details}}
              <p class="recipe-description">{{details}}</p>
            {{/if}}

            <div class="recipe-meta">
              {{#if serving}}
                <div class="recipe-meta-item">
                  <span class="label">Serving:</span>
                  <span class="value">
                    {{serving}} {{#if (eq serving 1)}}serving{{else}}servings{{/if}}
                  </span>
                </div>
              {{/if}}

              {{#if recipeType}}
                <div class="recipe-meta-item">
                  <span class="label">Type:</span>
                  <span class="value">{{recipeType}}</span>
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </div>

      <!-- ROW 2 -->
      <div class="row2">
        <div class="ingredients-cell">
          <section class="ingredients">
            <h2>Ingredients</h2>
            <ul>
              {{#if ingredientList}}
                {{#each ingredientList}}
                  <li>{{this}}</li>
                {{/each}}
              {{else}}
                {{#if ingredient}}
                  <li>{{ingredient}}</li>
                {{else}}
                  <li>No ingredients</li>
                {{/if}}
              {{/if}}
            </ul>
          </section>
        </div>

        <div class="method-cell">
          <section class="method">
            <h2>Method</h2>
            <ol>
              {{#if directionsList}}
                {{#each directionsList}}
                  <li>{{this}}</li>
                {{/each}}
              {{else}}
                {{#if howToMake}}
                  {{#each (splitDirections howToMake)}}
                    <li>{{this}}</li>
                  {{/each}}
                {{else}}
                  {{#if preparationMethod}}
                    {{#each (splitDirections preparationMethod)}}
                      <li>{{this}}</li>
                    {{/each}}
                  {{else}}
                    <li>No method provided</li>
                  {{/if}}
                {{/if}}
              {{/if}}
            </ol>
          </section>
        </div>
      </div>

    </div>
  </div>
</body>
</html>
