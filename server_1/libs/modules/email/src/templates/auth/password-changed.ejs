<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Changed Successfully</title>
  <style>
    body {
      font-family: 'Inter', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 0;
    }
    .header {
      background-color: #28a745;
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
    }
    .content {
      padding: 40px 20px;
    }
    .greeting {
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 20px;
      color: #333;
    }
    .success-box {
      background-color: #d4edda;
      border: 1px solid #c3e6cb;
      border-radius: 12px;
      padding: 20px;
      margin: 20px 0;
    }
    .success-title {
      font-size: 18px;
      font-weight: 600;
      color: #155724;
      margin: 0 0 10px 0;
    }
    .success-text {
      font-size: 16px;
      color: #155724;
      margin: 5px 0;
    }
    .change-time {
      font-size: 14px;
      color: #155724;
      margin-top: 10px;
    }
    .warning {
      background-color: #fff3cd;
      border-left: 4px solid #ffc107;
      padding: 15px;
      margin: 20px 0;
      border-radius: 8px;
    }
    .warning-text {
      font-size: 14px;
      color: #856404;
      margin: 5px 0;
    }
    .message {
      font-size: 16px;
      color: #666;
      margin-bottom: 20px;
      line-height: 1.8;
    }
    .footer {
      background-color: #f8f9fa;
      padding: 30px 20px;
      text-align: center;
      border-top: 1px solid #e9ecef;
    }
    .footer-text {
      font-size: 12px;
      color: #666;
      margin: 5px 0;
    }
    .footer-brand {
      font-size: 14px;
      font-weight: 600;
      color: #fc2305;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>✓ Password Changed Successfully</h1>
    </div>
    
    <div class="content">
      <div class="greeting">Hello <%= userName || 'User' %>,</div>
      
      <div class="success-box">
        <p class="success-title">Your password has been successfully changed.</p>
        <% if (changeTime) { %>
        <p class="change-time">Changed at: <%= changeTime %></p>
        <% } %>
      </div>
      
      <div class="message">
        <p>If you did not change your password, please contact our support team immediately as your account may be compromised.</p>
      </div>
      
      <div class="warning">
        <p class="warning-text">
          <strong>🔒 Security Tip:</strong> For your security, we recommend:
        </p>
        <ul style="margin: 10px 0; padding-left: 20px; color: #856404;">
          <li>Using a strong, unique password</li>
          <li>Not sharing your password with anyone</li>
          <li>Logging out when using shared devices</li>
        </ul>
      </div>
    </div>
    
    <div class="footer">
      <p class="footer-text">This is an automated email. Please do not reply.</p>
      <p class="footer-brand">EatFit247 Admin</p>
      <p class="footer-text">© <%= new Date().getFullYear() %> EatFit247. All rights reserved.</p>
    </div>
  </div>
</body>
</html>

