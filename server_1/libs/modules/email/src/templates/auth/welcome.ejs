<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to EatFit247 Admin</title>
  <style>
    body {
      font-family: 'Inter', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 0;
    }
    .header {
      background-color: #fc2305;
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
    }
    .content {
      padding: 40px 20px;
    }
    .greeting {
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 20px;
      color: #333;
    }
    .message {
      font-size: 16px;
      color: #666;
      margin-bottom: 30px;
      line-height: 1.8;
    }
    .info-box {
      background-color: #f8f9fa;
      border-left: 4px solid #fc2305;
      padding: 15px;
      margin: 20px 0;
      border-radius: 8px;
    }
    .info-text {
      font-size: 14px;
      color: #666;
      margin: 5px 0;
    }
    .footer {
      background-color: #f8f9fa;
      padding: 30px 20px;
      text-align: center;
      border-top: 1px solid #e9ecef;
    }
    .footer-text {
      font-size: 12px;
      color: #666;
      margin: 5px 0;
    }
    .footer-brand {
      font-size: 14px;
      font-weight: 600;
      color: #fc2305;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>Welcome to EatFit247 Admin</h1>
    </div>
    
    <div class="content">
      <div class="greeting">Hello <%= userName || 'User' %>,</div>
      
      <div class="message">
        <p>Welcome to the EatFit247 Admin Portal! Your account has been successfully created.</p>
        <p>You can now access the admin dashboard to manage your operations.</p>
      </div>
      
      <div class="info-box">
        <p class="info-text"><strong>Your Account Details:</strong></p>
        <% if (emailId) { %>
        <p class="info-text">Email: <%= emailId %></p>
        <% } %>
        <% if (loginUrl) { %>
        <p class="info-text">Login URL: <a href="<%= loginUrl %>" style="color: #fc2305;"><%= loginUrl %></a></p>
        <% } %>
      </div>
      
      <div class="message">
        <p>If you have any questions or need assistance, please don't hesitate to contact our support team.</p>
      </div>
    </div>
    
    <div class="footer">
      <p class="footer-text">This is an automated email. Please do not reply.</p>
      <p class="footer-brand">EatFit247 Admin</p>
      <p class="footer-text">© <%= new Date().getFullYear() %> EatFit247. All rights reserved.</p>
    </div>
  </div>
</body>
</html>

