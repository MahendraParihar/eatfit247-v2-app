<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EatFit247 - Diet Plan</title>
  <style>
    body {
      font-family: 'Inter', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 0;
    }
    .header {
      background-color: #fc2305;
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
    }
    .content {
      padding: 40px 20px;
    }
    .greeting {
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 20px;
      color: #333;
    }
    .message {
      font-size: 16px;
      color: #666;
      margin-bottom: 30px;
      line-height: 1.8;
    }
    .plan-box {
      background-color: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 20px;
      margin: 20px 0;
    }
    .plan-title {
      font-size: 18px;
      font-weight: 600;
      color: #fc2305;
      margin: 0 0 15px 0;
    }
    .plan-details {
      font-size: 14px;
      color: #666;
      margin: 5px 0;
    }
    .button-container {
      text-align: center;
      margin: 30px 0;
    }
    .button {
      display: inline-block;
      padding: 14px 32px;
      background-color: #fc2305;
      color: white;
      text-decoration: none;
      border-radius: 12px;
      font-weight: 500;
      font-size: 16px;
    }
    .footer {
      background-color: #f8f9fa;
      padding: 30px 20px;
      text-align: center;
      border-top: 1px solid #e9ecef;
    }
    .footer-text {
      font-size: 12px;
      color: #666;
      margin: 5px 0;
    }
    .footer-brand {
      font-size: 14px;
      font-weight: 600;
      color: #fc2305;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>Your Diet Plan</h1>
    </div>
    
    <div class="content">
      <div class="greeting">Hello <%= userName || 'User' %>,</div>
      
      <div class="message">
        <p>Your personalized diet plan is ready! We've created a customized nutrition plan based on your goals and preferences.</p>
      </div>
      
      <div class="plan-box">
        <p class="plan-title">Diet Plan Details</p>
        <% if (planName) { %>
        <p class="plan-details"><strong>Plan Name:</strong> <%= planName %></p>
        <% } %>
        <% if (planDuration) { %>
        <p class="plan-details"><strong>Duration:</strong> <%= planDuration %></p>
        <% } %>
        <% if (planLink) { %>
        <p class="plan-details"><strong>View Plan:</strong> <a href="<%= planLink %>" style="color: #fc2305;">Click here</a></p>
        <% } %>
      </div>
      
      <% if (planLink) { %>
      <div class="button-container">
        <a href="<%= planLink %>" class="button">View My Diet Plan</a>
      </div>
      <% } %>
      
      <div class="message">
        <p>If you have any questions about your diet plan, please don't hesitate to contact our nutrition team.</p>
      </div>
    </div>
    
    <div class="footer">
      <p class="footer-text">This is an automated email. Please do not reply.</p>
      <p class="footer-brand">EatFit247</p>
      <p class="footer-text">© <%= new Date().getFullYear() %> EatFit247. All rights reserved.</p>
    </div>
  </div>
</body>
</html>

