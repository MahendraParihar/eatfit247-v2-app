# Database Configuration
DB_USER='your_db_username'
DB_PASSWORD='your_db_password'
DB_NAME='your_database_name'
DB_HOST='localhost'
DB_PORT='5432'
DB_SCHEMA='public'

# Application Configuration
ASSET_PATH=/home/app/assets/media-files

ACCESS_TOKEN_TIME='5M'
REFRESH_TOKEN_TIME='7D'
JWT_ACCESS_SECRET=''
JWT_REFRESH_SECRET=''
PASSWORD_RESET_EXPIRATION_MIN=60 # 60 minutes
BCRYPT_SALT_ROUNDS=12
NODE_ENV='dev'

# Port Configuration
PORT=3000

# Checkout Session Token (public website — no user login)
# Generate with: openssl rand -base64 48
CHECKOUT_TOKEN_SECRET=''
CHECKOUT_TOKEN_EXPIRY='24h'

# AES-256-CBC Encryption Keys — generate strong random values for each environment
# Tip: openssl rand -base64 32
CRYPTO_SECRET_KEY=''
CRYPTO_SECRET_IV=''
CRYPTO_API_SECRET_KEY=''
CRYPTO_API_SECRET_IV=''
