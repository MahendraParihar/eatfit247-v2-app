{
  "name": "server_1",
  "version": "1.0.0",
  "license": "Private",
  "scripts": {
    "build_shared_lib": "npm --prefix ../shared-library run build",
    "dev_shared_lib": "npm --prefix ../shared-library run dev",
    "start": "concurrently \"npm run dev_shared_lib\" \"nx run-many --target=serve --maxParallel=7 --projects=public-api\"",
    "build": "npm run build_shared_lib && nx clear-cache && nx run-many --target=build --projects=admin-api,public-api --skip-nx-cache",
    "lint": "nx run-many --target=lint --all",
    "start:admin": "nx serve admin-api",
    "start:public": "nx serve public-api",
    "build:admin": "nx build admin-api",
    "build:public": "nx build public-api",
    "postinstall": "npm run build_shared_lib",
    "analyze:dependencies": "node scripts/generate-dependency-graph.js"
  },
  "private": true,
  "overrides": {
    "glob": "^10.5.0",
    "rimraf": "^5.0.10"
  },
