FROM node:22-alpine AS build
RUN apk add g++ make py3-pip
WORKDIR /home/app
RUN mkdir -p eatfit247-admin && mkdir -p shared-library && mkdir -p infra
COPY ./infra/ ./infra/
COPY ./shared-library/package*.json ./shared-library/
RUN npm --prefix shared-library install
COPY ./eatfit247-admin ./eatfit247-admin
RUN npm --prefix eatfit247-admin install
COPY ./shared-library ./shared-library
RUN npm --prefix eatfit247-admin run build

FROM nginx:latest AS ngi
COPY --from=build /home/app/eatfit247-admin/dist/apps/main /usr/share/nginx/html
COPY /infra/nginx-admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80