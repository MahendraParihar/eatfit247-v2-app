# Docker Compose variables, used only to fill in ${...} in docker-compose.yml.
# Copy to infra/.env. Compose reads infra/.env automatically (it sits next to the
# compose file); it never reads main.env for these. main.env is only passed into the
# containers (env_file).
#
# Relative host paths are resolved from infra/, so ../private-files = <repo>/private-files.

# Host folders (bind-mount sources)
MEDIA_FILES_PATH=../media-files
PRIVATE_FILES_PATH=../private-files
ASSET_PATH=/home/projects/eatfit247-v2-app/media-files
PRIVATE_ASSET_PATH=/home/projects/eatfit247-v2-app/private-files
