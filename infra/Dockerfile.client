FROM node:22-alpine AS build

# Native deps for node-gyp
RUN apk add --no-cache g++ make python3

WORKDIR /home/app
RUN mkdir -p eatfit247-web && mkdir -p shared-library && mkdir -p infra
COPY ./infra/ ./infra/

# -------------------------------
# Shared library
# -------------------------------
COPY shared-library/package.json shared-library/tsconfig.json shared-library/
COPY shared-library/src shared-library/src
RUN cd shared-library && npm install && npm run build

# -------------------------------
# Web app
# -------------------------------
COPY ./eatfit247-web ./eatfit247-web
RUN npm --prefix eatfit247-web install --legacy-peer-deps
# Build both browser and server bundles for SSR
RUN npm --prefix eatfit247-web run build

# -------------------------------
# Production stage with SSR server + Nginx
# -------------------------------
FROM node:22-alpine AS production

# Install nginx and dumb-init for proper signal handling
RUN apk add --no-cache nginx dumb-init

WORKDIR /home/app

# Copy shared library build
COPY --from=build /home/app/shared-library/dist ./shared-library/dist
COPY --from=build /home/app/shared-library/package.json ./shared-library/

# Copy web app build (both browser and server)
COPY --from=build /home/app/eatfit247-web/dist/eatfit247-web ./eatfit247-web/dist/eatfit247-web
COPY --from=build /home/app/eatfit247-web/package.json ./eatfit247-web/
COPY --from=build /home/app/eatfit247-web/server.ts ./eatfit247-web/

# Install only production dependencies
RUN npm --prefix eatfit247-web install --omit=dev --legacy-peer-deps

# Create nginx directories
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/run /etc/nginx/conf.d

# Set environment variables
ENV NODE_ENV=production
ENV PORT=4000

# Expose nginx port (SSR server runs on internal port 4000)
EXPOSE 443

# Create startup script to run both SSR server and nginx
RUN echo '#!/bin/sh' > /start.sh && \
    echo 'set -e' >> /start.sh && \
    echo 'echo "Starting SSR server on port 4000..."' >> /start.sh && \
    echo 'node eatfit247-web/dist/eatfit247-web/server/server.mjs &' >> /start.sh && \
    echo 'SSR_PID=$!' >> /start.sh && \
    echo 'echo "SSR server started with PID: $SSR_PID"' >> /start.sh && \
    echo 'sleep 2' >> /start.sh && \
    echo 'echo "Starting nginx..."' >> /start.sh && \
    echo 'nginx -g "daemon off;"' >> /start.sh && \
    chmod +x /start.sh

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start both SSR server and nginx
CMD ["/start.sh"]