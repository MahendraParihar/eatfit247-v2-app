FROM node:22
RUN apt-get update
RUN apt-get install -y g++ make python3-pip
RUN apt-get install -y chromium
WORKDIR /home/app
RUN mkdir server_1 && mkdir shared-library
COPY ./shared-library/package*.json ./shared-library/
RUN npm --prefix shared-library install
COPY ./shared-library ./shared-library
COPY ./server_1/package*.json ./server_1/
COPY ./server_1 ./server_1
RUN npm --prefix server_1 install
RUN npm --prefix server_1 run build
EXPOSE 3000
EXPOSE 3001