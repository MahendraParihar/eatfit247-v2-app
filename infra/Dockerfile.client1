FROM node:22-alpine AS build

# Native deps for node-gyp
RUN apk add --no-cache g++ make python3

WORKDIR /home/app
RUN mkdir -p eatfit247-web-1 && mkdir -p shared-library && mkdir -p infra
COPY ./infra/ ./infra/

# -------------------------------
# Shared library
# -------------------------------
COPY shared-library/package.json shared-library/tsconfig.json shared-library/
COPY shared-library/src shared-library/src
RUN cd shared-library && npm install && npm run build

# -------------------------------
# Web app
# -------------------------------
COPY ./eatfit247-web-1 ./eatfit247-web-1
RUN npm --prefix eatfit247-web-1 install --legacy-peer-deps

# Set environment variables for Nx build
# Disable Nx daemon (causes hangs in Docker - this is critical!)
# Increase Node memory for large builds
ENV NX_DAEMON=false
ENV NODE_OPTIONS=--max-old-space-size=4096

# Ensure .nx directory exists (created by postinstall, but ensure it's there)
RUN mkdir -p eatfit247-web-1/.nx

# Build both browser and server bundles for SSR
# Use nx directly with explicit project name and production configuration
# The --verbose flag helps debug if build hangs
RUN cd eatfit247-web-1 && npx nx build eatfit247-web-1 --configuration=production --verbose

# -------------------------------
# Production stage with SSR server + Nginx
# -------------------------------
FROM node:22-alpine AS production

# Install nginx and dumb-init for proper signal handling
RUN apk add --no-cache nginx dumb-init

WORKDIR /home/app

# Copy shared library (needed for eatfit247-web-1 dependency)
COPY --from=build /home/app/shared-library ./shared-library

# Copy web app build (both browser and server)
COPY --from=build /home/app/eatfit247-web-1/dist/eatfit247-web-1 ./eatfit247-web-1/dist/eatfit247-web-1
COPY --from=build /home/app/eatfit247-web-1/package.json ./eatfit247-web-1/
COPY --from=build /home/app/eatfit247-web-1/tsconfig.json ./eatfit247-web-1/
COPY --from=build /home/app/eatfit247-web-1/tsconfig.app.json ./eatfit247-web-1/
# Copy server.ts to dist/server folder so paths resolve correctly
COPY --from=build /home/app/eatfit247-web-1/src/server.ts ./eatfit247-web-1/dist/eatfit247-web-1/server/
# Copy src directory needed for server.ts imports (main.server.ts)
COPY --from=build /home/app/eatfit247-web-1/src ./eatfit247-web-1/src

# Install only production dependencies
# Note: @angular/compiler is in dependencies, so it will be installed
RUN npm --prefix eatfit247-web-1 install --omit=dev --legacy-peer-deps

# Install tsx globally to run TypeScript server file
RUN npm install -g tsx

# Create nginx directories and copy nginx config
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/run /etc/nginx/conf.d
COPY --from=build /home/app/infra/nginx.conf /etc/nginx/nginx.conf

# Set environment variables
ENV NODE_ENV=production
ENV PORT=4001

# Expose nginx port (SSR server runs on internal port 4001)
EXPOSE 443

# Create startup script to run both SSR server and nginx
RUN echo '#!/bin/sh' > /start.sh && \
    echo 'set -e' >> /start.sh && \
    echo 'cd /home/app/eatfit247-web-1/dist/eatfit247-web-1/server' >> /start.sh && \
    echo 'echo "Starting SSR server on port 4001..."' >> /start.sh && \
    echo 'tsx server.ts &' >> /start.sh && \
    echo 'SSR_PID=$!' >> /start.sh && \
    echo 'echo "SSR server started with PID: $SSR_PID"' >> /start.sh && \
    echo 'sleep 2' >> /start.sh && \
    echo 'echo "Starting nginx..."' >> /start.sh && \
    echo 'nginx -g "daemon off;"' >> /start.sh && \
    chmod +x /start.sh

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start both SSR server and nginx
CMD ["/start.sh"]

