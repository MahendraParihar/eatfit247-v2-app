    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.10",
    "@angular/compiler": "^20.3.10",
    "@angular/core": "^20.3.10",
    "@angular/forms": "^20.3.10",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.10",
    "@angular/router": "^20.3.10",
    "eatfit247-shared-library": "file:../shared-library",
    "razorpay": "^1.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.3.10",
    "@angular-devkit/schematics": "^20.3.10",
    "@angular/build": "^20.3.10",
    "@angular/cli": "^20.3.10",
    "@angular/compiler-cli": "^20.3.10",
    "@nx/angular": "22.4.1",
    "@nx/workspace": "22.4.1",
    "@schematics/angular": "^20.3.10",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.23",
    "concurrently": "^9.1.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "22.4.1",
    "typescript": "~5.9.2"
  }
