  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "nx serve --proxy-config proxy.conf.json",
    "dev": "nx serve main",
    "dev:main": "nx serve main",
    "dev_all": "concurrently \"npm run dev\"",
    "build": "nx build",
