{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "ES2022",
    "module": "commonjs",
    "declaration": true,
    "lib": ["es6", "dom", "es2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["node_modules/@types"],
    "composite": true,
    "incremental": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts", "**/*.js", "**/*.js.map"]
}

