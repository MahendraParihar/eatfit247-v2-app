<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'EatFit247' %></title>
  <style>
    body {
      font-family: 'Inter', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 0;
    }
    .content {
      padding: 40px 20px;
    }
  </style>
  <%- include('../partials/styles') %>
</head>
<body>
  <div class="email-container">
    <%- include('../partials/header', { title: title || 'EatFit247' }) %>
    
    <div class="content">
      <%- body %>
    </div>
    
    <%- include('../partials/footer') %>
  </div>
</body>
</html>

