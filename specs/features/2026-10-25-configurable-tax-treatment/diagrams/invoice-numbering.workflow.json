  "cards": [
    {
      "dot": "emerald",
      "title": "Every franchise has its own counters",
      "items": [
        "Key: franchise, type, FY, series (+ registration); created only by migration or admin",
        "No counter: the entry fails and rolls back (CGST Rule 46(b), UAE ER Art 59(1)(d))"
      ]
    }
  ]
