{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "EatFit247 Invoice Numbering",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "home-series",
        "label": "Franchise series",
        "focus": [
          "saved",
          "issueDate",
          "series",
          "franchiseCounter",
          "render",
          "guard",
          "commit"
        ],
        "note": "A PAID payment takes the next number from its franchise counter."
      },
      {
        "id": "foreign-series",
        "label": "Foreign registration",
        "focus": [
          "series",
          "registrationCounter",
          "render"
        ],
        "note": "A sale under a registration in another country uses that registration's own counter (4.14)."
      },
      {
        "id": "no-number",
        "label": "No number issued",
        "focus": [
          "saved",
          "proforma",
          "franchiseCounter",
          "guard",
          "refused"
        ],
        "note": "PENDING rows stay proforma; a missing counter or a number over 16 characters refuses the whole entry: no row, counter unchanged."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "Admin entry"
        },
        "backend": {
          "label": "Service step"
        },
        "security": {
          "label": "Guard / refusal"
        },
        "database": {
          "label": "Tax data / counter"
        },
        "cloud": {
          "label": "Zero-rated / foreign tax"
        },
        "external": {
          "label": "Document"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "issue-lane",
      "label": "PAID to number (per franchise)"
